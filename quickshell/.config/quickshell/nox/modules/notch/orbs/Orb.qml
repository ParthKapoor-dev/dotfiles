import QtQuick
import Quickshell.Io

// One Orbkit shader orb. Runtime ported from Orbkit's orbkit-core.tsx
// (MIT, (c) 2026 zzzzshawn, https://github.com/zzzzshawn/orbkit); shaders generated by
// nox orbs-build. Licences in CREDITS.md (XorDev orbs: non-commercial, attribution).
//   Orb { orb: "shdr-21"; orbState: "thinking"; size: 22; tint: "#FF5A1F" }
// Mirrors orbkit-core.tsx: integrated clocks, uTime = t/2, uAnim flow clock whose
// speed follows output volume, synthesised volumes per state, and a critically
// damped spring (omega 4) gliding params/colours/speed between state presets.
// Time is driven by a Timer at 1000/fps ms; running: false stops it (frame frozen).
Item {
    id: root

    property string orb: "shdr-11"
    property string orbState: "idle"          // idle | thinking | speaking
    property real size: 22
    property bool running: true
    property int fps: 30
    property color tint: "transparent"        // alpha 0 = none; alpha = strength

    readonly property var meta: _meta         // label, note, credit, license, params, colors…
    readonly property bool ready: _effect !== null

    width: size
    height: size
    implicitWidth: size
    implicitHeight: size

    property var _meta: null
    property var _effect: null
    readonly property real _dpr: (root.Window.window && root.Window.window.devicePixelRatio) || Screen.devicePixelRatio || 1

    // ---- engine state (orbkit-core.tsx uploadAndDraw) ----
    readonly property real _ease: 4           // PARAM_EASE
    property real _t: 0
    property real _anim: 0
    property real _speed: 0.1
    property real _speedVel: 0
    property real _in: 0
    property real _out: 0.3
    property var _pCur: ({})
    property var _pVel: ({})
    property var _pClock: ({})
    property var _cCur: ({})
    property var _cVel: ({})
    property real _last: 0

    function _clamp01(n) { return Math.min(1, Math.max(0, n)); }

    function _targetVolumes(st, t) {
        if (st === "speaking")
            return [_clamp01(0.65 + Math.sin(t * 4.8) * 0.22), _clamp01(0.75 + Math.sin(t * 3.6) * 0.22)];
        if (st === "thinking") {
            const base = 0.38 + 0.07 * Math.sin(t * 0.7);
            const wander = 0.05 * Math.sin(t * 2.1) * Math.sin(t * 0.37 + 1.2);
            return [_clamp01(base + wander), _clamp01(0.48 + 0.12 * Math.sin(t * 1.05 + 0.6))];
        }
        return [0, 0.3];
    }

    // critically damped spring, implicit step — returns [x, v]
    function _spring(x, v, target, dt, omega) {
        const f = 1 + 2 * dt * omega;
        const oo = omega * omega;
        const hoo = dt * oo;
        const hhoo = dt * hoo;
        const detInv = 1 / (f + hhoo);
        return [(f * x + dt * v + hhoo * target) * detInv, (v + hoo * (target - x)) * detInv];
    }

    // snap: land exactly on the state's targets (the core's reduce-motion frame);
    // used when the state changes while the timer is stopped, so a frozen orb shows the new state
    function _step(dt, snap) {
        const e = _effect, m = _meta;
        if (!e || !m)
            return;
        const st = (orbState === "thinking" || orbState === "speaking") ? orbState : "idle";
        const tv = _targetVolumes(st, _t);
        const kVol = 1 - Math.exp(-dt * 12);
        _in += (tv[0] - _in) * kVol;
        _out += (tv[1] - _out) * kVol;

        const targetSpeed = 0.1 + (1 - Math.pow(_out - 1, 2)) * 0.9;
        const s = snap ? [targetSpeed, 0] : _spring(_speed, _speedVel, targetSpeed, dt, _ease);
        _speed = s[0];
        _speedVel = s[1];
        _anim += dt * _speed;

        e.uTime = _t * 0.5;
        e.uAnim = _anim;
        e.uInput = _in;
        e.uOutput = _out;

        const preset = (m.statePresets || {})[st] || {};
        for (const p of m.params) {
            const target = preset[p.key] !== undefined ? preset[p.key] : p.default;
            const cur = _pCur[p.key] !== undefined ? _pCur[p.key] : target;
            const r = snap ? [target, 0] : _spring(cur, _pVel[p.key] || 0, target, dt, _ease);
            _pCur[p.key] = r[0];
            _pVel[p.key] = r[1];
            if (p.integrate) {
                if (_pClock[p.key] === undefined)
                    _pClock[p.key] = Math.random() * 100;
                _pClock[p.key] += dt * _speed * r[0];
                e["uP_" + p.key] = _pClock[p.key];
            } else {
                e["uP_" + p.key] = r[0];
            }
        }
        const sc = (m.stateColors || {})[st] || {};
        for (const c of m.colors) {
            const target = sc[c.key] || c.default;
            const cur = _cCur[c.key] || target.slice();
            const vel = _cVel[c.key] || [0, 0, 0];
            for (let i = 0; i < 3; i++) {
                const r = snap ? [target[i], 0] : _spring(cur[i], vel[i], target[i], dt, _ease);
                cur[i] = r[0];
                vel[i] = r[1];
            }
            _cCur[c.key] = cur;
            _cVel[c.key] = vel;
            e["uC_" + c.key] = Qt.vector3d(cur[0], cur[1], cur[2]);
        }
    }

    function _tick() {
        const now = Date.now() / 1000;
        // the core clamps dt at 50 ms (stall guard); a capped fps needs room for its own period
        const dt = Math.min(now - _last, Math.max(0.05, 2 / Math.max(1, fps)));
        _last = now;
        _t += dt;
        _step(dt);
    }

    function _build() {
        if (_effect) {
            _effect.destroy();
            _effect = null;
        }
        _meta = null;
        let m = null;
        try {
            m = JSON.parse(jsonFile.text());
        } catch (err) {
            console.warn("Orb: cannot read " + jsonFile.path + ": " + err);
            return;
        }
        const props = ["property vector2d uRes: Qt.vector2d(Math.max(1, Math.round(width * root._dpr)), Math.max(1, Math.round(height * root._dpr)))",
                       "property real uTime: 0", "property real uAnim: 0",
                       "property real uInput: 0", "property real uOutput: 0.3",
                       "property vector4d uTint: Qt.vector4d(root.tint.r, root.tint.g, root.tint.b, root.tint.a)"];
        for (const c of m.colors)
            props.push("property vector3d uC_" + c.key + ": Qt.vector3d(" + c.default.join(",") + ")");
        for (const p of m.params)
            props.push("property real uP_" + p.key + ": " + Number(p.default));
        const src = "import QtQuick\nShaderEffect {\n anchors.fill: parent\n blending: true\n fragmentShader: \""
            + Qt.resolvedUrl(m.shader || (orb + ".frag.qsb")) + "\"\n " + props.join("\n ") + "\n}\n";
        try {
            _effect = Qt.createQmlObject(src, root, "orb-" + orb);
        } catch (err) {
            console.warn("Orb: cannot build " + orb + ": " + err);
            return;
        }
        _meta = m;
        // fresh driver state, as on a new canvas generation in the core
        _t = 0;
        _anim = Math.random() * 100;
        _speed = 0.1;
        _speedVel = 0;
        const st = (orbState === "thinking" || orbState === "speaking") ? orbState : "idle";
        const v = _targetVolumes(st, 0);
        _in = v[0];
        _out = v[1];
        _pCur = {};
        _pVel = {};
        _pClock = {};
        _cCur = {};
        _cVel = {};
        _last = Date.now() / 1000;
        _step(1);   // first frame: dt = 1 lands the glide on its targets
    }

    onOrbStateChanged: if (_effect && !_timer.running) _step(1, true)

    FileView {
        id: jsonFile
        path: {
            const u = Qt.resolvedUrl(root.orb + ".json").toString();
            return decodeURIComponent(u.startsWith("file://") ? u.slice(7) : u);
        }
        blockLoading: true
        printErrors: false
        onLoaded: root._build()
        onLoadFailed: console.warn("Orb: no orb named " + root.orb)
    }

    Timer {
        id: _timer
        interval: Math.max(1, Math.round(1000 / Math.max(1, root.fps)))
        repeat: true
        running: root.running && root.visible && root._effect !== null
        onRunningChanged: if (running) root._last = Date.now() / 1000
        onTriggered: root._tick()
    }
}
