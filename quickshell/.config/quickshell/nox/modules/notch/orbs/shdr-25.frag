layout(location = 0) in vec2 qt_TexCoord0;
layout(location = 0) out vec4 fragColor;

layout(std140, binding = 0) uniform buf {
    mat4 qt_Matrix;
    float qt_Opacity;
    vec2 uRes;
    float uTime;
    float uAnim;
    float uInput;
    float uOutput;
    vec4 uTint;
    vec3 uC_tint;
    vec3 uC_body;
    vec3 uC_sheen;
    float uP_speed;
    float uP_drift;
    float uP_swirl;
    float uP_radius;
    float uP_scale;
    float uP_bulge;
    float uP_warp;
    float uP_zoom;
    float uP_ripple;
    float uP_edgeGain;
    float uP_blur;
    float uP_fringe;
    float uP_exposure;
    float uP_contrast;
    float uP_saturation;
    float uP_floorLevel;
    float uP_light;
    float uP_rim;
