    mat4 qt_Matrix;
    float qt_Opacity;
    vec2 uRes;
    float uTime;
    float uAnim;
    float uInput;
    float uOutput;
    vec4 uTint;
    vec3 uC_tint;
    float uP_speed;
    float uP_camDist;
    float uP_focal;
    float uP_shellR;
    float uP_pitch;
    float uP_turb;
    float uP_slack;
    float uP_width;
    float uP_hueGain;
    float uP_floorLevel;
    float uP_envScale;
