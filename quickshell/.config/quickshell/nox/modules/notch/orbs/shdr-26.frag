layout(location = 0) in vec2 qt_TexCoord0;
layout(location = 0) out vec4 fragColor;

layout(std140, binding = 0) uniform buf {
    mat4 qt_Matrix;
    float qt_Opacity;
    vec2 uRes;
    float uTime;
    float uAnim;
    float uInput;
    float uOutput;
    vec4 uTint;
    vec3 uC_deep;
    vec3 uC_line;
    vec3 uC_hot;
    vec3 uC_sheen;
    float uP_speed;
    float uP_swirl;
    float uP_drift;
    float uP_radius;
    float uP_scale;
    float uP_bulge;
    float uP_warp;
    float uP_pole;
    float uP_poleSoft;
    float uP_pulse;
    float uP_sharp;
    float uP_split;
    float uP_core;
    float uP_floor;
    float uP_gain;
    float uP_contrast;
    float uP_light;
    float uP_rim;
