layout(location = 0) out vec4 fragColor;

layout(std140, binding = 0) uniform buf {
    mat4 qt_Matrix;
    float qt_Opacity;
    vec2 uRes;
    float uTime;
    float uAnim;
    float uInput;
    float uOutput;
    vec4 uTint;
    vec3 uC_tint;
    float uP_speed;
    float uP_wander;
    float uP_camDist;
    float uP_focal;
    float uP_fieldScale;
    float uP_turb;
    float uP_stepScale;
    float uP_disperse;
    float uP_envRadius;
    float uP_envCore;
    float uP_fill;
    float uP_stepClamp;
    float uP_scatter;
    float uP_exposure;
    float uP_contrast;
    float uP_saturation;
    float uP_alphaGain;
    float uP_edge;
    float uP_edgeFade;
