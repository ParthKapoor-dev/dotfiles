layout(location = 0) in vec2 qt_TexCoord0;
layout(location = 0) out vec4 fragColor;

layout(std140, binding = 0) uniform buf {
    mat4 qt_Matrix;
    float qt_Opacity;
    vec2 uRes;
    float uTime;
    float uAnim;
    float uInput;
    float uOutput;
    vec4 uTint;
    vec3 uC_low;
    vec3 uC_high;
    vec3 uC_body;
    vec3 uC_sheen;
    float uP_speed;
    float uP_swirl;
    float uP_slide;
    float uP_radius;
    float uP_scale;
    float uP_bulge;
    float uP_grow;
    float uP_vary;
    float uP_skew;
    float uP_jitter;
    float uP_edge;
    float uP_bead;
    float uP_gain;
    float uP_contrast;
    float uP_saturation;
    float uP_floorLevel;
    float uP_light;
    float uP_rim;
