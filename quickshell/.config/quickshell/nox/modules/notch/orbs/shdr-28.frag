layout(location = 0) in vec2 qt_TexCoord0;
layout(location = 0) out vec4 fragColor;

layout(std140, binding = 0) uniform buf {
    mat4 qt_Matrix;
    float qt_Opacity;
    vec2 uRes;
    float uTime;
    float uAnim;
    float uInput;
    float uOutput;
    vec4 uTint;
    vec3 uC_lineA;
    vec3 uC_lineB;
    vec3 uC_base;
    vec3 uC_rim;
    float uP_speed;
    float uP_spin;
    float uP_tilt;
    float uP_radius;
    float uP_gridScale;
    float uP_levels;
    float uP_lineW;
    float uP_shutter;
    float uP_gain;
    float uP_body;
    float uP_rim;
    float uP_rimPow;
    float uP_contrast;
    float uP_edge;
    float uP_edgeFade;
