diff --git a/kdeconnect-core/src/plugins/mousepad.rs b/kdeconnect-core/src/plugins/mousepad.rs
index 9103934..bf059e3 100644
--- a/kdeconnect-core/src/plugins/mousepad.rs
+++ b/kdeconnect-core/src/plugins/mousepad.rs
@@ -1,6 +1,515 @@
+//! Remote Input (`kdeconnect.mousepad.*`): the phone acts as a touchpad and
+//! keyboard.
+//!
+//! This module is the protocol half only: it turns a
+//! `kdeconnect.mousepad.request` body into a list of abstract
+//! [`InputAction`]s, with the same precedence and defaults as the official
+//! desktop (kdeconnect-kde `plugins/mousepad/waylandremoteinput.cpp`). The
+//! service turns those actions into Wayland virtual-pointer / virtual-keyboard
+//! requests (kdeconnect-service `remote_input.rs`).
+
 use serde::{Deserialize, Serialize};
+use serde_json::Value;
+
+/// linux/input-event-codes.h pointer buttons.
+pub const BTN_LEFT: u32 = 0x110;
+pub const BTN_RIGHT: u32 = 0x111;
+pub const BTN_MIDDLE: u32 = 0x112;
+
+/// linux/input-event-codes.h key codes used by the special-key table.
+pub mod keys {
+    pub const KEY_ESC: u32 = 1;
+    pub const KEY_BACKSPACE: u32 = 14;
+    pub const KEY_TAB: u32 = 15;
+    pub const KEY_ENTER: u32 = 28;
+    pub const KEY_LEFTCTRL: u32 = 29;
+    pub const KEY_LEFTSHIFT: u32 = 42;
+    pub const KEY_LEFTALT: u32 = 56;
+    pub const KEY_F1: u32 = 59;
+    pub const KEY_F2: u32 = 60;
+    pub const KEY_F3: u32 = 61;
+    pub const KEY_F4: u32 = 62;
+    pub const KEY_F5: u32 = 63;
+    pub const KEY_F6: u32 = 64;
+    pub const KEY_F7: u32 = 65;
+    pub const KEY_F8: u32 = 66;
+    pub const KEY_F9: u32 = 67;
+    pub const KEY_F10: u32 = 68;
+    pub const KEY_SCROLLLOCK: u32 = 70;
+    pub const KEY_F11: u32 = 87;
+    pub const KEY_F12: u32 = 88;
+    pub const KEY_SYSRQ: u32 = 99;
+    pub const KEY_LINEFEED: u32 = 101;
+    pub const KEY_HOME: u32 = 102;
+    pub const KEY_UP: u32 = 103;
+    pub const KEY_PAGEUP: u32 = 104;
+    pub const KEY_LEFT: u32 = 105;
+    pub const KEY_RIGHT: u32 = 106;
+    pub const KEY_END: u32 = 107;
+    pub const KEY_DOWN: u32 = 108;
+    pub const KEY_PAGEDOWN: u32 = 109;
+    pub const KEY_DELETE: u32 = 111;
+    pub const KEY_LEFTMETA: u32 = 125;
+}
+
+use keys::*;
+
+/// `specialKey` → evdev key code. Index is the protocol value; keep in sync
+/// with `SpecialKeysMap` in kdeconnect-kde and `KeyListenerView.SpecialKeysMap`
+/// in kdeconnect-android. 0 (and 3 on Android, which sends Enter as 12) is
+/// unused/invalid.
+pub const SPECIAL_KEYS: [u32; 33] = [
+    0,              // 0  invalid
+    KEY_BACKSPACE,  // 1
+    KEY_TAB,        // 2
+    KEY_LINEFEED,   // 3
+    KEY_LEFT,       // 4
+    KEY_UP,         // 5
+    KEY_RIGHT,      // 6
+    KEY_DOWN,       // 7
+    KEY_PAGEUP,     // 8
+    KEY_PAGEDOWN,   // 9
+    KEY_HOME,       // 10
+    KEY_END,        // 11
+    KEY_ENTER,      // 12
+    KEY_DELETE,     // 13
+    KEY_ESC,        // 14
+    KEY_SYSRQ,      // 15
+    KEY_SCROLLLOCK, // 16
+    KEY_LEFTCTRL,   // 17
+    KEY_LEFTALT,    // 18
+    KEY_LEFTSHIFT,  // 19
+    KEY_LEFTMETA,   // 20
+    KEY_F1,         // 21
+    KEY_F2,         // 22
+    KEY_F3,         // 23
+    KEY_F4,         // 24
+    KEY_F5,         // 25
+    KEY_F6,         // 26
+    KEY_F7,         // 27
+    KEY_F8,         // 28
+    KEY_F9,         // 29
+    KEY_F10,        // 30
+    KEY_F11,        // 31
+    KEY_F12,        // 32
+];
+
+/// Map a protocol `specialKey` value to an evdev key code.
+pub fn special_key_code(special_key: i64) -> Option<u32> {
+    if special_key <= 0 {
+        return None;
+    }
+    SPECIAL_KEYS
+        .get(special_key as usize)
+        .copied()
+        .filter(|code| *code != 0)
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Modifiers {
+    pub ctrl: bool,
+    pub alt: bool,
+    pub shift: bool,
+    pub super_: bool,
+}
+
+impl Modifiers {
+    pub fn any(&self) -> bool {
+        self.ctrl || self.alt || self.shift || self.super_
+    }
+
+    /// The evdev codes of the modifier keys that are held, in press order.
+    pub fn key_codes(&self) -> Vec<u32> {
+        let mut codes = Vec::new();
+        if self.ctrl {
+            codes.push(KEY_LEFTCTRL);
+        }
+        if self.alt {
+            codes.push(KEY_LEFTALT);
+        }
+        if self.shift {
+            codes.push(KEY_LEFTSHIFT);
+        }
+        if self.super_ {
+            codes.push(KEY_LEFTMETA);
+        }
+        codes
+    }
+}
+
+/// One `kdeconnect.mousepad.request` body. Parsed leniently, like the Qt
+/// `np.get<T>(key, default)` calls upstream: a missing or mistyped field
+/// takes its default instead of rejecting the whole packet.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct MousePadRequest {
+    pub dx: f64,
+    pub dy: f64,
+    pub x: Option<f64>,
+    pub y: Option<f64>,
+    pub single_click: bool,
+    pub double_click: bool,
+    pub middle_click: bool,
+    pub right_click: bool,
+    pub single_hold: bool,
+    pub single_release: bool,
+    pub scroll: bool,
+    pub key: String,
+    pub special_key: i64,
+    pub modifiers: Modifiers,
+    pub send_ack: bool,
+}
+
+fn get_bool(body: &Value, key: &str) -> bool {
+    match body.get(key) {
+        Some(Value::Bool(b)) => *b,
+        Some(Value::Number(n)) => n.as_f64().is_some_and(|v| v != 0.0),
+        Some(Value::String(s)) => s.eq_ignore_ascii_case("true"),
+        _ => false,
+    }
+}
+
+fn get_f64(body: &Value, key: &str) -> Option<f64> {
+    match body.get(key) {
+        Some(Value::Number(n)) => n.as_f64().filter(|v| v.is_finite()),
+        Some(Value::String(s)) => s.trim().parse::<f64>().ok().filter(|v| v.is_finite()),
+        _ => None,
+    }
+}
+
+impl MousePadRequest {
+    pub fn from_body(body: &Value) -> Self {
+        Self {
+            dx: get_f64(body, "dx").unwrap_or(0.0),
+            dy: get_f64(body, "dy").unwrap_or(0.0),
+            x: get_f64(body, "x"),
+            y: get_f64(body, "y"),
+            single_click: get_bool(body, "singleclick"),
+            double_click: get_bool(body, "doubleclick"),
+            middle_click: get_bool(body, "middleclick"),
+            right_click: get_bool(body, "rightclick"),
+            single_hold: get_bool(body, "singlehold"),
+            single_release: get_bool(body, "singlerelease"),
+            scroll: get_bool(body, "scroll"),
+            key: body
+                .get("key")
+                .and_then(Value::as_str)
+                .unwrap_or_default()
+                .to_string(),
+            special_key: get_f64(body, "specialKey").map_or(0, |v| v as i64),
+            modifiers: Modifiers {
+                ctrl: get_bool(body, "ctrl"),
+                alt: get_bool(body, "alt"),
+                shift: get_bool(body, "shift"),
+                super_: get_bool(body, "super"),
+            },
+            send_ack: get_bool(body, "sendAck"),
+        }
+    }
+
+    /// The actions this request asks for, in the order they must be
+    /// injected. Mirrors `WaylandRemoteInput::handlePacket` upstream: the
+    /// first matching click/hold/scroll/key field wins; a request with none
+    /// of those is a relative pointer motion.
+    pub fn actions(&self) -> Vec<InputAction> {
+        let click = |button| {
+            [
+                InputAction::Button { button, pressed: true },
+                InputAction::Button { button, pressed: false },
+            ]
+        };
 
+        let is_command = self.single_click
+            || self.double_click
+            || self.middle_click
+            || self.right_click
+            || self.single_hold
+            || self.single_release
+            || self.scroll
+            || !self.key.is_empty()
+            || self.special_key != 0;
+
+        if !is_command {
+            if self.dx != 0.0 || self.dy != 0.0 {
+                return vec![InputAction::Motion {
+                    dx: self.dx,
+                    dy: self.dy,
+                }];
+            }
+            // Absolute `x`/`y` positioning has no in-tree sender (the
+            // Android app only sends deltas) and needs output geometry to
+            // map onto; ignore it, like an empty packet.
+            return Vec::new();
+        }
+
+        if self.single_click {
+            click(BTN_LEFT).to_vec()
+        } else if self.double_click {
+            [click(BTN_LEFT), click(BTN_LEFT)].concat()
+        } else if self.middle_click {
+            click(BTN_MIDDLE).to_vec()
+        } else if self.right_click {
+            click(BTN_RIGHT).to_vec()
+        } else if self.single_hold {
+            vec![InputAction::Button {
+                button: BTN_LEFT,
+                pressed: true,
+            }]
+        } else if self.single_release {
+            vec![InputAction::Button {
+                button: BTN_LEFT,
+                pressed: false,
+            }]
+        } else if self.scroll {
+            // KDE Connect's vertical sign is the opposite of Wayland's
+            // (positive dy = scroll up); horizontal matches. Same inversion
+            // upstream applies before handing the delta to libei.
+            if self.dx == 0.0 && self.dy == 0.0 {
+                return Vec::new();
+            }
+            vec![InputAction::Scroll {
+                horizontal: self.dx,
+                vertical: -self.dy,
+            }]
+        } else {
+            let special = special_key_code(self.special_key);
+            if special.is_none() && self.key.is_empty() {
+                return Vec::new();
+            }
+            let mods = self.modifiers;
+            let mut out = Vec::new();
+            for code in mods.key_codes() {
+                out.push(InputAction::Key { code, pressed: true });
+            }
+            if mods.any() {
+                out.push(InputAction::SetModifiers(mods));
+            }
+            if let Some(code) = special {
+                out.push(InputAction::Key { code, pressed: true });
+                out.push(InputAction::Key { code, pressed: false });
+            } else {
+                out.push(InputAction::Text(self.key.clone()));
+            }
+            if mods.any() {
+                out.push(InputAction::SetModifiers(Modifiers::default()));
+            }
+            for code in mods.key_codes().into_iter().rev() {
+                out.push(InputAction::Key { code, pressed: false });
+            }
+            out
+        }
+    }
+
+    /// Body of the `kdeconnect.mousepad.echo` reply sent when the request
+    /// carried `sendAck`: the request echoed back with `isAck: true`.
+    pub fn ack_body(body: &Value) -> Value {
+        let mut echo = body.clone();
+        if let Value::Object(map) = &mut echo {
+            map.remove("sendAck");
+            map.insert("isAck".into(), Value::Bool(true));
+        }
+        echo
+    }
+
+    /// True for the high-rate packets (pointer motion / scroll) that should
+    /// not be logged above debug level.
+    pub fn is_high_rate(&self) -> bool {
+        self.key.is_empty()
+            && self.special_key == 0
+            && !(self.single_click
+                || self.double_click
+                || self.middle_click
+                || self.right_click
+                || self.single_hold
+                || self.single_release)
+    }
+}
+
+/// Abstract input action, independent of the injection backend.
+#[derive(Clone, Debug, PartialEq)]
+pub enum InputAction {
+    /// Relative pointer motion in (unaccelerated) pixels.
+    Motion { dx: f64, dy: f64 },
+    /// Pointer button (`BTN_*`) press or release.
+    Button { button: u32, pressed: bool },
+    /// Continuous scroll in Wayland convention (positive = down / right).
+    Scroll { horizontal: f64, vertical: f64 },
+    /// Key press/release by evdev key code.
+    Key { code: u32, pressed: bool },
+    /// Set the logical modifier state for the following key events.
+    SetModifiers(Modifiers),
+    /// Type arbitrary Unicode text (one key press/release per character).
+    Text(String),
+}
+
+/// `kdeconnect.mousepad.keyboardstate`, desktop → phone: whether the desktop
+/// can receive keyboard input. The official desktop sends it on connect.
 #[derive(Debug, Default, Deserialize, Serialize)]
 pub struct KeyboardState {
-    state: Option<bool>,
+    pub state: Option<bool>,
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    fn actions(body: Value) -> Vec<InputAction> {
+        MousePadRequest::from_body(&body).actions()
+    }
+
+    #[test]
+    fn motion() {
+        assert_eq!(
+            actions(json!({"dx": 3.5, "dy": -2})),
+            vec![InputAction::Motion { dx: 3.5, dy: -2.0 }]
+        );
+        assert!(actions(json!({})).is_empty());
+        assert!(actions(json!({"dx": 0, "dy": 0})).is_empty());
+        // absolute positioning is not supported
+        assert!(actions(json!({"x": 0.5, "y": 0.5})).is_empty());
+    }
+
+    #[test]
+    fn clicks() {
+        let press = |button| InputAction::Button { button, pressed: true };
+        let release = |button| InputAction::Button { button, pressed: false };
+        assert_eq!(
+            actions(json!({"singleclick": true})),
+            vec![press(BTN_LEFT), release(BTN_LEFT)]
+        );
+        assert_eq!(
+            actions(json!({"doubleclick": true})),
+            vec![press(BTN_LEFT), release(BTN_LEFT), press(BTN_LEFT), release(BTN_LEFT)]
+        );
+        assert_eq!(
+            actions(json!({"middleclick": true})),
+            vec![press(BTN_MIDDLE), release(BTN_MIDDLE)]
+        );
+        assert_eq!(
+            actions(json!({"rightclick": true})),
+            vec![press(BTN_RIGHT), release(BTN_RIGHT)]
+        );
+        assert_eq!(actions(json!({"singlehold": true})), vec![press(BTN_LEFT)]);
+        assert_eq!(actions(json!({"singlerelease": true})), vec![release(BTN_LEFT)]);
+        // a click packet never also moves the pointer
+        assert_eq!(
+            actions(json!({"singleclick": true, "dx": 5, "dy": 5})),
+            vec![press(BTN_LEFT), release(BTN_LEFT)]
+        );
+        // false flags are ignored
+        assert_eq!(
+            actions(json!({"singleclick": false, "dx": 1})),
+            vec![InputAction::Motion { dx: 1.0, dy: 0.0 }]
+        );
+    }
+
+    #[test]
+    fn scroll_inverts_vertical() {
+        assert_eq!(
+            actions(json!({"scroll": true, "dx": 0.0, "dy": 7.5})),
+            vec![InputAction::Scroll { horizontal: 0.0, vertical: -7.5 }]
+        );
+        assert_eq!(
+            actions(json!({"scroll": true, "dx": -4, "dy": 0})),
+            vec![InputAction::Scroll { horizontal: -4.0, vertical: 0.0 }]
+        );
+        assert!(actions(json!({"scroll": true})).is_empty());
+    }
+
+    #[test]
+    fn special_keys() {
+        assert_eq!(special_key_code(0), None);
+        assert_eq!(special_key_code(-1), None);
+        assert_eq!(special_key_code(1), Some(KEY_BACKSPACE));
+        assert_eq!(special_key_code(12), Some(KEY_ENTER));
+        assert_eq!(special_key_code(14), Some(KEY_ESC));
+        assert_eq!(special_key_code(9), Some(KEY_PAGEDOWN));
+        assert_eq!(special_key_code(25), Some(KEY_F5));
+        assert_eq!(special_key_code(32), Some(KEY_F12));
+        assert_eq!(special_key_code(33), None);
+
+        assert_eq!(
+            actions(json!({"specialKey": 4})),
+            vec![
+                InputAction::Key { code: KEY_LEFT, pressed: true },
+                InputAction::Key { code: KEY_LEFT, pressed: false },
+            ]
+        );
+        // out-of-range special key: nothing, and no stray motion either
+        assert!(actions(json!({"specialKey": 99, "dx": 3})).is_empty());
+    }
+
+    #[test]
+    fn modifiers_wrap_special_key() {
+        // Android "close window" = alt + F4
+        assert_eq!(
+            actions(json!({"alt": true, "specialKey": 24})),
+            vec![
+                InputAction::Key { code: KEY_LEFTALT, pressed: true },
+                InputAction::SetModifiers(Modifiers { alt: true, ..Default::default() }),
+                InputAction::Key { code: KEY_F4, pressed: true },
+                InputAction::Key { code: KEY_F4, pressed: false },
+                InputAction::SetModifiers(Modifiers::default()),
+                InputAction::Key { code: KEY_LEFTALT, pressed: false },
+            ]
+        );
+    }
+
+    #[test]
+    fn text_with_and_without_modifiers() {
+        assert_eq!(
+            actions(json!({"key": "héllo ✓"})),
+            vec![InputAction::Text("héllo ✓".into())]
+        );
+        let mods = Modifiers { ctrl: true, shift: true, ..Default::default() };
+        assert_eq!(
+            actions(json!({"key": "c", "ctrl": true, "shift": true})),
+            vec![
+                InputAction::Key { code: KEY_LEFTCTRL, pressed: true },
+                InputAction::Key { code: KEY_LEFTSHIFT, pressed: true },
+                InputAction::SetModifiers(mods),
+                InputAction::Text("c".into()),
+                InputAction::SetModifiers(Modifiers::default()),
+                InputAction::Key { code: KEY_LEFTSHIFT, pressed: false },
+                InputAction::Key { code: KEY_LEFTCTRL, pressed: false },
+            ]
+        );
+        // specialKey wins over key
+        assert_eq!(
+            actions(json!({"key": "x", "specialKey": 12})),
+            vec![
+                InputAction::Key { code: KEY_ENTER, pressed: true },
+                InputAction::Key { code: KEY_ENTER, pressed: false },
+            ]
+        );
+    }
+
+    #[test]
+    fn lenient_parsing() {
+        let req = MousePadRequest::from_body(&json!({
+            "dx": "1.5", "dy": null, "singleclick": 1, "key": 5,
+            "specialKey": 12.0, "super": true, "sendAck": true
+        }));
+        assert_eq!(req.dx, 1.5);
+        assert_eq!(req.dy, 0.0);
+        assert!(req.single_click);
+        assert_eq!(req.key, "");
+        assert_eq!(req.special_key, 12);
+        assert!(req.modifiers.super_);
+        assert!(req.send_ack);
+    }
+
+    #[test]
+    fn ack_echoes_body() {
+        let echo = MousePadRequest::ack_body(&json!({"key": "a", "sendAck": true}));
+        assert_eq!(echo, json!({"key": "a", "isAck": true}));
+    }
+
+    #[test]
+    fn high_rate_classification() {
+        assert!(MousePadRequest::from_body(&json!({"dx": 1})).is_high_rate());
+        assert!(MousePadRequest::from_body(&json!({"scroll": true, "dy": 1})).is_high_rate());
+        assert!(!MousePadRequest::from_body(&json!({"singleclick": true})).is_high_rate());
+        assert!(!MousePadRequest::from_body(&json!({"key": "a"})).is_high_rate());
+    }
 }
