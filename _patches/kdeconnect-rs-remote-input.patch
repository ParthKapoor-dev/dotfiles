+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn modifier_masks() {
+        assert_eq!(modifier_mask(Modifiers::default()), 0);
+        assert_eq!(
+            modifier_mask(Modifiers { ctrl: true, ..Default::default() }),
+            0b100
+        );
+        assert_eq!(
+            modifier_mask(Modifiers {
+                ctrl: true,
+                alt: true,
+                shift: true,
+                super_: true
+            }),
+            0b0100_1101
+        );
+    }
+
+    #[test]
+    fn keysym_names() {
+        assert_eq!(VirtualKeymap::keysym_name('a').as_deref(), Some("U0061"));
+        assert_eq!(VirtualKeymap::keysym_name(' ').as_deref(), Some("U0020"));
+        assert_eq!(VirtualKeymap::keysym_name('é').as_deref(), Some("U00E9"));
+        assert_eq!(VirtualKeymap::keysym_name('✓').as_deref(), Some("U2713"));
+        assert_eq!(VirtualKeymap::keysym_name('😀').as_deref(), Some("U1F600"));
+        assert_eq!(VirtualKeymap::keysym_name('\u{1}'), None);
+        assert_eq!(VirtualKeymap::keysym_name('\u{85}'), None);
+    }
+
+    #[test]
+    fn plan_assigns_stable_slots() {
+        let mut keymap = VirtualKeymap::new();
+        let chunks = keymap.plan("abca");
+        assert_eq!(chunks.len(), 1);
+        assert!(chunks[0].keymap.is_some());
+        assert_eq!(chunks[0].codes, vec![128, 129, 130, 128]);
+
+        // Known characters: no upload needed.
+        let chunks = keymap.plan("cab");
+        assert_eq!(
+            chunks,
+            vec![TextChunk { keymap: None, codes: vec![130, 128, 129] }]
+        );
+
+        // One new character: upload, old slots unchanged.
+        let chunks = keymap.plan("ad");
+        assert_eq!(chunks.len(), 1);
+        assert_eq!(chunks[0].codes, vec![128, 131]);
+        let rendered = chunks[0].keymap.as_ref().unwrap();
+        assert!(rendered.contains("key <K139> { [ U0064 ] };"));
+        assert!(rendered.contains("key <K136> { [ U0061 ] };"));
+    }
+
+    #[test]
+    fn plan_uses_fixed_keys_and_skips_control_chars() {
+        let mut keymap = VirtualKeymap::new();
+        let chunks = keymap.plan("a\nb\t\u{1}");
+        assert_eq!(chunks.len(), 1);
+        assert_eq!(chunks[0].codes, vec![128, KEY_ENTER, 129, KEY_TAB]);
+
+        // Only fixed keys: nothing to upload.
+        let chunks = keymap.plan("\r\n");
+        assert_eq!(
+            chunks,
+            vec![TextChunk { keymap: None, codes: vec![KEY_ENTER, KEY_ENTER] }]
+        );
+        assert!(keymap.plan("").is_empty());
+        assert!(keymap.plan("\u{1}\u{2}").is_empty());
+    }
+
+    #[test]
+    fn plan_resets_when_full() {
+        let mut keymap = VirtualKeymap::new();
+        // 130 distinct CJK characters: more than the 120 dynamic slots.
+        let text: String = (0..130u32)
+            .map(|i| char::from_u32(0x4E00 + i).unwrap())
+            .collect();
+        let chunks = keymap.plan(&text);
+        assert_eq!(chunks.len(), 2);
+        assert_eq!(chunks[0].codes.len(), DYNAMIC_CAPACITY);
+        assert_eq!(chunks[1].codes.len(), 10);
+        assert_eq!(chunks[1].codes[0], DYNAMIC_FIRST);
+        assert!(chunks.iter().all(|chunk| chunk.keymap.is_some()));
+        assert!(
+            chunks
+                .iter()
+                .flat_map(|chunk| &chunk.codes)
+                .all(|code| (DYNAMIC_FIRST..=DYNAMIC_LAST).contains(code))
+        );
+        // After the reset only the last 10 characters are known.
+        let last: String = text.chars().skip(120).collect();
+        assert_eq!(keymap.plan(&last)[0].keymap, None);
+    }
+
+    #[test]
+    fn rendered_keymap_shape() {
+        let mut keymap = VirtualKeymap::new();
+        keymap.plan("Hé");
+        let text = keymap.render();
+        assert!(text.contains("<K22> = 22;")); // BackSpace (evdev 14)
+        assert!(text.contains("key <K36> { [ Return ] };"));
+        assert!(text.contains("key <K136> { [ U0048 ] };"));
+        assert!(text.contains("key <K137> { [ U00E9 ] };"));
+        assert!(text.contains("modifier_map Control { <K37> };"));
+        assert!(text.contains("modifier_map Mod4 { <K133> };"));
+        // every keycode within the X11-compatible range
+        for line in text.lines().filter(|l| l.contains("> = ")) {
+            let code: u32 = line
+                .trim()
+                .trim_end_matches(';')
+                .rsplit(' ')
+                .next()
+                .unwrap()
+                .parse()
+                .unwrap();
+            assert!((8..=255).contains(&code), "{line}");
+        }
+    }
+
+    /// Compiles generated keymaps with the system xkbcommon (`xkbcli`), the
+    /// same library the compositor uses. Skipped when xkbcli is missing.
+    #[test]
+    fn keymap_compiles_with_xkbcommon() {
+        let Ok(dir) = tempfile::tempdir() else { return };
+        let mut keymap = VirtualKeymap::new();
+        keymap.plan("Hello, wörld! ✓ 😀 ~`'\"\\{}[]<>");
+        let path = dir.path().join("keymap.xkb");
+        std::fs::write(&path, keymap.render()).unwrap();
+        let output = match std::process::Command::new("xkbcli")
+            .arg("compile-keymap")
+            // v1: the format zwp_virtual_keyboard_v1 hands to the compositor
+            .args(["--input-format", "1", "--keymap"])
+            .arg(&path)
+            .output()
+        {
+            Ok(output) => output,
+            Err(_) => {
+                eprintln!("xkbcli not installed; skipping");
+                return;
+            }
+        };
+        assert!(
+            output.status.success(),
+            "xkbcli failed: {}",
+            String::from_utf8_lossy(&output.stderr)
+        );
+        let compiled = String::from_utf8_lossy(&output.stdout);
+        for sym in ["U2713", "U1F600", "odiaeresis", "BackSpace", "Super_L"] {
+            assert!(compiled.contains(sym), "{sym} missing from compiled keymap");
+        }
+    }
+}
