+//! Remote Input backend: injects the phone's touchpad / keyboard actions
+//! (`kdeconnect.mousepad.request`, parsed by kdeconnect-core's
+//! `plugins::mousepad`) into the Wayland session.
+//!
+//! Uses the wlroots-family virtual input protocols, which Hyprland, Sway and
+//! river expose to ordinary clients:
+//! - `zwlr_virtual_pointer_v1` for relative motion, buttons and scrolling;
+//! - `zwp_virtual_keyboard_v1` for keys and text.
+//!
+//! A virtual keyboard brings its own XKB keymap, so arbitrary Unicode text is
+//! typed the way `wtype` does it: every character gets a keycode whose only
+//! keysym is that character (`U<hex>`), and the keymap is re-uploaded when new
+//! characters show up. Special keys (arrows, F-keys, Enter, modifiers...) keep
+//! their real evdev keycodes and standard keysyms in every keymap version.
+//!
+//! Like the clipboard worker, this runs on its own Wayland connection and
+//! calloop thread. Nothing touches the compositor until the first remote
+//! input packet arrives, and the virtual devices are created on first use.
+
+use anyhow::{Context, Result, anyhow};
+use calloop::{EventLoop, channel};
+use calloop_wayland_source::WaylandSource;
+use kdeconnect_core::plugins::mousepad::{InputAction, Modifiers, keys::*};
+use std::{
+    io::Write,
+    os::fd::AsFd,
+    sync::Mutex,
+    time::{Duration, Instant},
+};
+use tracing::{debug, info, warn};
+use wayland_client::{
+    Connection, Dispatch, Proxy, QueueHandle, delegate_noop,
+    protocol::{wl_pointer, wl_registry, wl_seat},
+};
+use wayland_protocols_misc::zwp_virtual_keyboard_v1::client::{
+    zwp_virtual_keyboard_manager_v1::ZwpVirtualKeyboardManagerV1,
+    zwp_virtual_keyboard_v1::ZwpVirtualKeyboardV1,
+};
+use wayland_protocols_wlr::virtual_pointer::v1::client::{
+    zwlr_virtual_pointer_manager_v1::ZwlrVirtualPointerManagerV1,
+    zwlr_virtual_pointer_v1::ZwlrVirtualPointerV1,
+};
+
+/// Multiplier from the phone's scroll delta (phone pixels after its own
+/// sensitivity setting) to Wayland continuous axis units. 1.0 makes a
+/// two-finger swipe behave roughly like a laptop touchpad.
+const SCROLL_SCALE: f64 = 1.0;
+
+/// `wl_keyboard.keymap_format.xkb_v1`
+const KEYMAP_FORMAT_XKB_V1: u32 = 1;
+const KEY_STATE_RELEASED: u32 = 0;
+const KEY_STATE_PRESSED: u32 = 1;
+
+/// Real-modifier bits as indexed by every XKB keymap (Shift, Lock, Control,
+/// Mod1..Mod5); the generated keymap maps Alt_L→Mod1 and Super_L→Mod4.
+const MOD_SHIFT: u32 = 1 << 0;
+const MOD_CONTROL: u32 = 1 << 2;
+const MOD_MOD1: u32 = 1 << 3;
+const MOD_MOD4: u32 = 1 << 6;
+
+pub fn modifier_mask(mods: Modifiers) -> u32 {
+    let mut mask = 0;
+    if mods.shift {
+        mask |= MOD_SHIFT;
+    }
+    if mods.ctrl {
+        mask |= MOD_CONTROL;
+    }
+    if mods.alt {
+        mask |= MOD_MOD1;
+    }
+    if mods.super_ {
+        mask |= MOD_MOD4;
+    }
+    mask
+}
+
+// ---------------------------------------------------------------------------
+// Keymap
+// ---------------------------------------------------------------------------
+
+/// Keys present in every keymap version, at their real evdev codes.
+const FIXED_KEYS: &[(u32, &str)] = &[
+    (KEY_ESC, "Escape"),
+    (KEY_BACKSPACE, "BackSpace"),
+    (KEY_TAB, "Tab"),
+    (KEY_ENTER, "Return"),
+    (KEY_LEFTCTRL, "Control_L"),
+    (KEY_LEFTSHIFT, "Shift_L"),
+    (KEY_LEFTALT, "Alt_L"),
+    (KEY_F1, "F1"),
+    (KEY_F2, "F2"),
+    (KEY_F3, "F3"),
+    (KEY_F4, "F4"),
+    (KEY_F5, "F5"),
+    (KEY_F6, "F6"),
+    (KEY_F7, "F7"),
+    (KEY_F8, "F8"),
+    (KEY_F9, "F9"),
+    (KEY_F10, "F10"),
+    (KEY_SCROLLLOCK, "Scroll_Lock"),
+    (KEY_F11, "F11"),
+    (KEY_F12, "F12"),
+    // KEY_SYSRQ is the Print Screen key on PC keyboards; Android sends it
+    // for KEYCODE_SYSRQ (also labelled PrtSc).
+    (KEY_SYSRQ, "Print"),
+    (KEY_LINEFEED, "Linefeed"),
+    (KEY_HOME, "Home"),
+    (KEY_UP, "Up"),
+    (KEY_PAGEUP, "Prior"),
+    (KEY_LEFT, "Left"),
+    (KEY_RIGHT, "Right"),
+    (KEY_END, "End"),
+    (KEY_DOWN, "Down"),
+    (KEY_PAGEDOWN, "Next"),
+    (KEY_DELETE, "Delete"),
+    (KEY_LEFTMETA, "Super_L"),
+];
+
+/// evdev codes handed out to typed characters. XKB keycodes are evdev + 8 and
+/// must stay ≤ 255 for X11/Xwayland clients, so 128..=247 (120 slots), well
+/// clear of every fixed key above.
+const DYNAMIC_FIRST: u32 = 128;
+const DYNAMIC_LAST: u32 = 247;
+const DYNAMIC_CAPACITY: usize = (DYNAMIC_LAST - DYNAMIC_FIRST + 1) as usize;
+
+/// One run of key taps; `keymap`, when set, must be uploaded first.
+#[derive(Debug, PartialEq)]
+pub struct TextChunk {
+    pub keymap: Option<String>,
+    pub codes: Vec<u32>,
+}
+
+/// The virtual keyboard's keymap: the fixed keys plus a growing table of
+/// typed characters (cleared when it runs out of keycodes).
+#[derive(Debug, Default)]
+pub struct VirtualKeymap {
+    chars: Vec<char>,
+}
+
+impl VirtualKeymap {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Characters typed with a fixed key instead of a dynamic keysym.
+    fn fixed_code_for_char(c: char) -> Option<u32> {
+        match c {
+            '\n' | '\r' => Some(KEY_ENTER),
+            '\t' => Some(KEY_TAB),
+            '\u{8}' => Some(KEY_BACKSPACE),
+            '\u{1b}' => Some(KEY_ESC),
+            '\u{7f}' => Some(KEY_DELETE),
+            _ => None,
+        }
+    }
+
+    /// XKB keysym name for a printable character. Control characters have no
+    /// keysym (xkbcommon rejects U0000-U001F and U007F-U009F).
+    pub fn keysym_name(c: char) -> Option<String> {
+        let cp = c as u32;
+        if cp < 0x20 || (0x7f..=0x9f).contains(&cp) {
+            return None;
+        }
+        Some(format!("U{cp:04X}"))
+    }
+
+    /// Plan typing `text`: the key codes to tap, split into chunks whenever
+    /// the keymap must be (re)uploaded first. Existing character slots never
+    /// move, so a chunk's keymap stays valid for keys planned earlier in the
+    /// same chunk; only a reset (table full) starts a new chunk.
+    pub fn plan(&mut self, text: &str) -> Vec<TextChunk> {
+        let mut chunks = Vec::new();
+        let mut codes = Vec::new();
+        let mut dirty = false;
+
+        for c in text.chars() {
+            if let Some(code) = Self::fixed_code_for_char(c) {
+                codes.push(code);
+                continue;
+            }
+            if Self::keysym_name(c).is_none() {
+                continue;
+            }
+            let slot = match self.chars.iter().position(|&known| known == c) {
+                Some(slot) => slot,
+                None => {
+                    if self.chars.len() == DYNAMIC_CAPACITY {
+                        chunks.push(TextChunk {
+                            keymap: dirty.then(|| self.render()),
+                            codes: std::mem::take(&mut codes),
+                        });
+                        self.chars.clear();
+                    }
+                    self.chars.push(c);
+                    dirty = true;
+                    self.chars.len() - 1
+                }
+            };
+            codes.push(DYNAMIC_FIRST + slot as u32);
+        }
+
+        if !codes.is_empty() || dirty {
+            chunks.push(TextChunk {
+                keymap: dirty.then(|| self.render()),
+                codes,
+            });
+        }
+        chunks
+    }
+
+    /// Render the keymap in XKB text format (v1).
+    pub fn render(&self) -> String {
+        let mut entries: Vec<(u32, String)> = FIXED_KEYS
+            .iter()
+            .map(|(code, sym)| (*code, (*sym).to_string()))
+            .collect();
+        for (slot, c) in self.chars.iter().enumerate() {
+            if let Some(name) = Self::keysym_name(*c) {
+                entries.push((DYNAMIC_FIRST + slot as u32, name));
+            }
+        }
+
+        let mut out = String::with_capacity(4096 + entries.len() * 48);
+        out.push_str("xkb_keymap {\nxkb_keycodes \"kdeconnect\" {\n");
+        out.push_str("    minimum = 8;\n    maximum = 255;\n");
+        for (code, _) in &entries {
+            let xkb = code + 8;
+            out.push_str(&format!("    <K{xkb}> = {xkb};\n"));
+        }
+        out.push_str("};\n");
+        out.push_str("xkb_types \"kdeconnect\" { include \"complete\" };\n");
+        out.push_str("xkb_compatibility \"kdeconnect\" { include \"complete\" };\n");
+        out.push_str("xkb_symbols \"kdeconnect\" {\n");
+        for (code, sym) in &entries {
+            out.push_str(&format!("    key <K{}> {{ [ {sym} ] }};\n", code + 8));
+        }
+        out.push_str(&format!(
+            "    modifier_map Shift {{ <K{}> }};\n",
+            KEY_LEFTSHIFT + 8
+        ));
+        out.push_str(&format!(
+            "    modifier_map Control {{ <K{}> }};\n",
+            KEY_LEFTCTRL + 8
+        ));
+        out.push_str(&format!(
+            "    modifier_map Mod1 {{ <K{}> }};\n",
+            KEY_LEFTALT + 8
+        ));
+        out.push_str(&format!(
+            "    modifier_map Mod4 {{ <K{}> }};\n",
+            KEY_LEFTMETA + 8
+        ));
+        out.push_str("};\n};\n");
+        out
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Wayland worker
+// ---------------------------------------------------------------------------
+
+struct WorkerState {
+    connection: Connection,
+    seat: Option<wl_seat::WlSeat>,
+    pointer_manager: Option<ZwlrVirtualPointerManagerV1>,
+    keyboard_manager: Option<ZwpVirtualKeyboardManagerV1>,
+    pointer: Option<ZwlrVirtualPointerV1>,
+    keyboard: Option<ZwpVirtualKeyboardV1>,
+    keymap: VirtualKeymap,
+    mods: u32,
+    epoch: Instant,
+}
+
+impl WorkerState {
+    fn time(&self) -> u32 {
+        self.epoch.elapsed().as_millis() as u32
+    }
+
+    fn ensure_pointer(&mut self, qh: &QueueHandle<Self>) -> Option<ZwlrVirtualPointerV1> {
+        if self.pointer.is_none() {
+            let manager = self.pointer_manager.as_ref()?;
+            let pointer = manager.create_virtual_pointer(self.seat.as_ref(), qh, ());
+            info!("[remote input] virtual pointer created");
+            self.pointer = Some(pointer);
+        }
+        self.pointer.clone()
+    }
+
+    fn ensure_keyboard(&mut self, qh: &QueueHandle<Self>) -> Option<ZwpVirtualKeyboardV1> {
+        if self.keyboard.is_none() {
+            let manager = self.keyboard_manager.as_ref()?;
+            let seat = self.seat.as_ref()?;
+            let keyboard = manager.create_virtual_keyboard(seat, qh, ());
+            // The protocol requires a keymap before the first key event.
+            let keymap = self.keymap.render();
+            if let Err(error) = upload_keymap(&keyboard, &keymap) {
+                warn!("[remote input] cannot upload keymap: {error:#}");
+                keyboard.destroy();
+                return None;
+            }
+            info!("[remote input] virtual keyboard created");
+            self.keyboard = Some(keyboard);
+        }
+        self.keyboard.clone()
+    }
+
+    fn key(&self, keyboard: &ZwpVirtualKeyboardV1, code: u32, pressed: bool) {
+        let state = if pressed {
+            KEY_STATE_PRESSED
+        } else {
+            KEY_STATE_RELEASED
+        };
+        keyboard.key(self.time(), code, state);
+    }
+
+    fn run(&mut self, actions: Vec<InputAction>, qh: &QueueHandle<Self>) {
+        for action in actions {
+            match action {
+                InputAction::Motion { dx, dy } => {
+                    let Some(pointer) = self.ensure_pointer(qh) else { return };
+                    pointer.motion(self.time(), dx, dy);
+                    pointer.frame();
+                }
+                InputAction::Button { button, pressed } => {
+                    let Some(pointer) = self.ensure_pointer(qh) else { return };
+                    let state = if pressed {
+                        wl_pointer::ButtonState::Pressed
+                    } else {
+                        wl_pointer::ButtonState::Released
+                    };
+                    pointer.button(self.time(), button, state);
+                    pointer.frame();
+                }
+                InputAction::Scroll {
+                    horizontal,
+                    vertical,
+                } => {
+                    let Some(pointer) = self.ensure_pointer(qh) else { return };
+                    let time = self.time();
+                    pointer.axis_source(wl_pointer::AxisSource::Continuous);
+                    if vertical != 0.0 {
+                        pointer.axis(
+                            time,
+                            wl_pointer::Axis::VerticalScroll,
+                            vertical * SCROLL_SCALE,
+                        );
+                    }
+                    if horizontal != 0.0 {
+                        pointer.axis(
+                            time,
+                            wl_pointer::Axis::HorizontalScroll,
+                            horizontal * SCROLL_SCALE,
+                        );
+                    }
+                    pointer.frame();
+                }
+                InputAction::Key { code, pressed } => {
+                    let Some(keyboard) = self.ensure_keyboard(qh) else { return };
+                    self.key(&keyboard, code, pressed);
+                }
+                InputAction::SetModifiers(mods) => {
+                    let Some(keyboard) = self.ensure_keyboard(qh) else { return };
+                    self.mods = modifier_mask(mods);
+                    keyboard.modifiers(self.mods, 0, 0, 0);
+                }
+                InputAction::Text(text) => {
+                    let Some(keyboard) = self.ensure_keyboard(qh) else { return };
+                    for chunk in self.keymap.plan(&text) {
+                        if let Some(keymap) = chunk.keymap {
+                            if let Err(error) = upload_keymap(&keyboard, &keymap) {
+                                warn!("[remote input] cannot upload keymap: {error:#}");
+                                return;
+                            }
+                            // A new keymap may reset the compositor's
+                            // modifier state; restore the requested one.
+                            keyboard.modifiers(self.mods, 0, 0, 0);
+                        }
+                        for code in chunk.codes {
+                            self.key(&keyboard, code, true);
+                            self.key(&keyboard, code, false);
+                        }
+                    }
+                }
+            }
+        }
+        if let Err(error) = self.connection.flush() {
+            warn!("[remote input] flush failed: {error}");
+        }
+    }
+}
+
+/// Hand a keymap to the compositor through an unlinked temp file
+/// (NUL-terminated, as wl_keyboard keymaps are).
+fn upload_keymap(keyboard: &ZwpVirtualKeyboardV1, keymap: &str) -> Result<()> {
+    let mut file = tempfile::tempfile().context("cannot create keymap file")?;
+    file.write_all(keymap.as_bytes())
+        .and_then(|_| file.write_all(&[0]))
+        .and_then(|_| file.flush())
+        .context("cannot write keymap file")?;
+    keyboard.keymap(
+        KEYMAP_FORMAT_XKB_V1,
+        file.as_fd(),
+        keymap.len() as u32 + 1,
+    );
+    // The fd is duplicated into the request; ours can close now.
+    Ok(())
+}
+
+impl Dispatch<wl_registry::WlRegistry, ()> for WorkerState {
+    fn event(
+        state: &mut Self,
+        registry: &wl_registry::WlRegistry,
+        event: wl_registry::Event,
+        _: &(),
+        _: &Connection,
+        qh: &QueueHandle<Self>,
+    ) {
+        let wl_registry::Event::Global {
+            name,
+            interface,
+            version,
+        } = event
+        else {
+            return;
+        };
+        if interface == wl_seat::WlSeat::interface().name && state.seat.is_none() {
+            state.seat = Some(registry.bind(name, version.min(7), qh, ()));
+        } else if interface == ZwlrVirtualPointerManagerV1::interface().name {
+            state.pointer_manager = Some(registry.bind(name, version.min(2), qh, ()));
+        } else if interface == ZwpVirtualKeyboardManagerV1::interface().name {
+            state.keyboard_manager = Some(registry.bind(name, version.min(1), qh, ()));
+        }
+    }
+}
+
+delegate_noop!(WorkerState: ignore wl_seat::WlSeat);
+delegate_noop!(WorkerState: ZwlrVirtualPointerManagerV1);
+delegate_noop!(WorkerState: ZwlrVirtualPointerV1);
+delegate_noop!(WorkerState: ZwpVirtualKeyboardManagerV1);
+delegate_noop!(WorkerState: ZwpVirtualKeyboardV1);
+
+/// Connect and spawn the worker thread. Returns the command sender.
+fn spawn_worker() -> Result<channel::Sender<Vec<InputAction>>> {
+    let connection = crate::clipboard::connect_to_host_compositor()?;
+    let mut event_queue = connection.new_event_queue::<WorkerState>();
+    let qh = event_queue.handle();
+    connection.display().get_registry(&qh, ());
+
+    let mut state = WorkerState {
+        connection: connection.clone(),
+        seat: None,
+        pointer_manager: None,
+        keyboard_manager: None,
+        pointer: None,
+        keyboard: None,
+        keymap: VirtualKeymap::new(),
+        mods: 0,
+        epoch: Instant::now(),
+    };
+    event_queue
+        .roundtrip(&mut state)
+        .context("failed to enumerate Wayland globals")?;
+
+    if state.pointer_manager.is_none() && state.keyboard_manager.is_none() {
+        return Err(anyhow!(
+            "the compositor advertises neither zwlr_virtual_pointer_manager_v1 nor zwp_virtual_keyboard_manager_v1"
+        ));
+    }
+    if state.pointer_manager.is_none() {
+        warn!("[remote input] no zwlr_virtual_pointer_manager_v1: pointer input disabled");
+    }
+    if state.keyboard_manager.is_none() || state.seat.is_none() {
+        warn!("[remote input] no zwp_virtual_keyboard_manager_v1 or seat: keyboard input disabled");
+    }
+
+    let (sender, receiver) = channel::channel::<Vec<InputAction>>();
+    std::thread::Builder::new()
+        .name("kdeconnect-remote-input".to_string())
+        .spawn(move || {
+            let mut event_loop: EventLoop<WorkerState> = match EventLoop::try_new() {
+                Ok(event_loop) => event_loop,
+                Err(error) => {
+                    warn!("[remote input] cannot create event loop: {error}");
+                    return;
+                }
+            };
+            let handle = event_loop.handle();
+            if let Err(error) = WaylandSource::new(connection, event_queue).insert(handle.clone())
+            {
+                warn!("[remote input] cannot register Wayland source: {error}");
+                return;
+            }
+            if let Err(error) = handle.insert_source(receiver, move |event, _, state| {
+                if let channel::Event::Msg(actions) = event {
+                    state.run(actions, &qh);
+                }
+            }) {
+                warn!("[remote input] cannot register command source: {error}");
+                return;
+            }
+            info!("[remote input] Wayland virtual input worker started");
+            if let Err(error) = event_loop.run(None, &mut state, |_| {}) {
+                warn!("[remote input] worker stopped: {error}");
+            }
+        })
+        .context("failed to spawn remote input thread")?;
+    Ok(sender)
+}
+
+/// Lazily-started handle to the worker. Restarts it (at most every few
+/// seconds) if the Wayland connection was lost.
+#[derive(Default)]
+pub struct RemoteInput {
+    inner: Mutex<Inner>,
+}
+
+#[derive(Default)]
+struct Inner {
+    sender: Option<channel::Sender<Vec<InputAction>>>,
+    last_attempt: Option<Instant>,
+}
+
+const RETRY_INTERVAL: Duration = Duration::from_secs(5);
+
+impl RemoteInput {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    pub fn submit(&self, actions: Vec<InputAction>) {
+        if actions.is_empty() {
+            return;
+        }
+        let Ok(mut inner) = self.inner.lock() else {
+            return;
+        };
+        let actions = match inner.sender.as_ref() {
+            Some(sender) => match sender.send(actions) {
+                Ok(()) => return,
+                Err(std::sync::mpsc::SendError(actions)) => {
+                    warn!("[remote input] worker gone, reconnecting");
+                    inner.sender = None;
+                    actions
+                }
+            },
+            None => actions,
+        };
+
+        if inner
+            .last_attempt
+            .is_some_and(|at| at.elapsed() < RETRY_INTERVAL)
+        {
+            debug!("[remote input] unavailable, dropping input");
+            return;
+        }
+        inner.last_attempt = Some(Instant::now());
+        match spawn_worker() {
+            Ok(sender) => {
+                let _ = sender.send(actions);
+                inner.sender = Some(sender);
+            }
+            Err(error) => warn!("[remote input] unavailable: {error:#}"),
+        }
+    }
+}
