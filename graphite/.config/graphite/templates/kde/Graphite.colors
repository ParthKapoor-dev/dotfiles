[General]
ColorScheme=Graphite
Name=Graphite
shadeSortColumn=true

[KDE]
contrast=4

[WM]
activeBackground={{ color.surface | rgb }}
activeBlend={{ color.label | rgb }}
activeForeground={{ color.label | alpha(color.labelAlpha) | over(color.surface) | rgb }}
inactiveBackground={{ color.bg | rgb }}
inactiveBlend={{ color.label | alpha(color.label2Alpha) | over(color.bg) | rgb }}
