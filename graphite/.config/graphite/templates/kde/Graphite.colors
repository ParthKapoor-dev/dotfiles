# Graphite KDE colour scheme ({{ name }}, preset {{ _.preset }}) - generated by graphite-theme. Do not edit.
[ColorEffects:Disabled]
ChangeSelectionColor=
Color={{ color.bg | rgb }}
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
Enable=
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color={{ color.bg | rgb }}
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

[Colors:Button]
BackgroundAlternate={{ color.raised | rgb }}
BackgroundNormal={{ color.surface | rgb }}
DecorationFocus={{ color.accent | rgb }}
DecorationHover={{ color.accent | rgb }}
ForegroundActive={{ color.accent | lighten(0.2) | rgb }}
ForegroundInactive={{ color.label | alpha(color.label2Alpha) | over(color.surface) | rgb }}
ForegroundLink={{ color.accent | lighten(0.2) | rgb }}
ForegroundNegative={{ color.red | rgb }}
ForegroundNeutral={{ color.yellow | rgb }}
ForegroundNormal={{ color.label | alpha(color.labelAlpha) | over(color.surface) | rgb }}
ForegroundPositive={{ color.green | rgb }}
ForegroundVisited={{ color.purple | rgb }}

