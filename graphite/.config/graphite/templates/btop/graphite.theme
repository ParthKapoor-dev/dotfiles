# Graphite btop theme ({{ name }}, preset {{ _.preset }}) - generated by theme. Do not edit.
theme[main_bg]="{{ color.bg | hex }}"
theme[main_fg]="{{ color.label | alpha(color.labelAlpha) | over(color.bg) | hex }}"
theme[title]="{{ color.label | hex }}"
theme[hi_fg]="{{ color.accent | lighten(0.2) | hex }}"
theme[selected_bg]="{{ color.accent | hex }}"
theme[selected_fg]="{{ color.onAccent | hex }}"
theme[inactive_fg]="{{ color.label | alpha(color.label3Alpha) | over(color.bg) | hex }}"
theme[graph_text]="{{ color.label | alpha(color.label2Alpha) | over(color.bg) | hex }}"
theme[meter_bg]="{{ color.raised | hex }}"
theme[proc_misc]="{{ color.teal | hex }}"
theme[cpu_box]="{{ color.label | alpha(color.label3Alpha) | over(color.bg) | hex }}"
theme[mem_box]="{{ color.label | alpha(color.label3Alpha) | over(color.bg) | hex }}"
theme[net_box]="{{ color.label | alpha(color.label3Alpha) | over(color.bg) | hex }}"
theme[proc_box]="{{ color.label | alpha(color.label3Alpha) | over(color.bg) | hex }}"
theme[div_line]="{{ color.label | alpha(color.sepAlpha) | over(color.bg) | hex }}"
theme[temp_start]="{{ color.green | hex }}"
theme[temp_mid]="{{ color.yellow | hex }}"
theme[temp_end]="{{ color.red | hex }}"
theme[cpu_start]="{{ color.teal | hex }}"
theme[cpu_mid]="{{ color.blue | hex }}"
theme[cpu_end]="{{ color.purple | hex }}"
theme[free_start]="{{ color.green | darken(0.4) | hex }}"
theme[free_mid]="{{ color.green | darken(0.2) | hex }}"
theme[free_end]="{{ color.green | hex }}"
theme[cached_start]="{{ color.teal | darken(0.4) | hex }}"
theme[cached_mid]="{{ color.teal | darken(0.2) | hex }}"
theme[cached_end]="{{ color.teal | hex }}"
theme[available_start]="{{ color.blue | darken(0.4) | hex }}"
theme[available_mid]="{{ color.blue | darken(0.2) | hex }}"
theme[available_end]="{{ color.blue | hex }}"
theme[used_start]="{{ color.purple | darken(0.4) | hex }}"
theme[used_mid]="{{ color.purple | darken(0.2) | hex }}"
theme[used_end]="{{ color.purple | hex }}"
theme[download_start]="{{ color.blue | darken(0.4) | hex }}"
theme[download_mid]="{{ color.blue | darken(0.2) | hex }}"
theme[download_end]="{{ color.teal | hex }}"
theme[upload_start]="{{ color.purple | darken(0.4) | hex }}"
theme[upload_mid]="{{ color.purple | darken(0.2) | hex }}"
theme[upload_end]="{{ color.pink | hex }}"
theme[process_start]="{{ color.teal | hex }}"
theme[process_mid]="{{ color.blue | hex }}"
theme[process_end]="{{ color.purple | hex }}"
