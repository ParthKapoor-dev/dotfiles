{
  "_comment": "Graphite shell (qs -c graphite) user config. Live-reloaded. Missing keys fall back to built-in defaults (core/Config.qml). Widget ids are listed in modules/bar/BarWidgets.qml, control-center section ids in modules/controlcenter/CcSections.qml, launcher provider ids in modules/launcher/LauncherProviders.qml. modules.notifications is false while ii owns the org.freedesktop.Notifications D-Bus name; set it true once ii's notifications are gone.",
  "modules": { "bar": true, "dock": true, "controlCenter": true, "launcher": true, "osd": false, "notifications": false },
  "bar": {
    "screens": [],
    "left": ["logo", "appName", "workspaces"],
    "center": [],
    "right": ["tray", "network", "bluetooth", "volume", "battery", "controlCenter", "clock"]
  },
  "widgets": {
    "logo": {
      "menu": [
        { "label": "Lock Screen", "command": ["loginctl", "lock-session"] },
        { "separator": true },
        { "label": "Sleep", "command": ["systemctl", "suspend"] },
        { "label": "Restart…", "command": ["systemctl", "reboot"] },
        { "label": "Shut Down…", "command": ["systemctl", "poweroff"] }
      ]
    },
    "appName": { "fallback": "Desktop" },
    "windowTitle": { "maxWidth": 360 },
    "workspaces": { "minCount": 4, "scroll": true },
    "tray": { "monochrome": true },
    "network": { "settingsCommand": [] },
    "bluetooth": { "settingsCommand": ["blueman-manager"] },
    "volume": { "step": 0.05 },
    "battery": { "showPercent": "hover", "lowPercent": 20 },
    "clock": { "format": "ddd d MMM HH:mm", "clickPopup": "notifications" }
  },
  "dock": {
    "screens": [],
    "reserveSpace": true,
    "magnify": true,
    "showRunning": true,
    "ignoredAppIds": [],
    "pinned": ["zen", "slack", "dev.zed.Zed", "stably-orca", "netsoft-com.netsoft.hubstaff", "chromium", "helium", "com.mitchellh.ghostty"]
  },
  "controlCenter": {
    "sections": ["connectivity", "display", "sound", "media", "notifications"],
    "lockCommand": ["loginctl", "lock-session"]
  },
  "brightness": { "device": "auto", "step": 5 },
  "launcher": {
    "width": 680,
    "top": 0.18,
    "maxHeight": 404,
    "placeholder": "Search apps, windows, commands…",
    "providers": ["calculator", "apps", "windows", "commands", "run"],
    "provider": {
      "apps": { "limit": 8, "showRecent": true, "recentLimit": 6, "frecencyWeight": 0.35, "terminal": ["ghostty", "-e"] },
      "calculator": { "prefix": "=" },
      "windows": { "prefix": "@", "limit": 6 },
      "commands": {
        "prefix": "/",
        "limit": 6,
        "items": [
          { "label": "Lock Screen", "icon": "lock", "command": ["loginctl", "lock-session"], "keywords": ["lock"] },
          { "label": "Log Out", "icon": "logout", "command": ["hyprctl", "dispatch", "exit"], "confirm": "Log out now?", "keywords": ["logout", "sign out", "exit"] },
          { "label": "Sleep", "icon": "bedtime", "command": ["systemctl", "suspend"], "confirm": "Sleep now?", "keywords": ["suspend"] },
          { "label": "Restart", "icon": "restart_alt", "command": ["systemctl", "reboot"], "confirm": "Restart now?", "keywords": ["reboot"] },
          { "label": "Shut Down", "icon": "power_settings_new", "command": ["systemctl", "poweroff"], "confirm": "Shut down now?", "keywords": ["power off", "poweroff", "halt"] },
          { "label": "Do Not Disturb", "icon": "do_not_disturb_on", "action": "dnd", "keywords": ["dnd", "focus", "notifications"] },
          { "label": "Control Center", "icon": "toggle_on", "action": "controlCenter", "keywords": ["settings"] },
          { "label": "Notification Center", "icon": "notifications", "action": "notifications" },
          { "label": "Toggle Dock", "icon": "dock_to_bottom", "action": "dock" }
        ]
      },
      "run": { "prefix": ">", "prefixOnly": true, "shell": ["sh", "-c"], "terminal": ["ghostty", "-e"] }
    }
  },
  "osd": {
    "position": "bottom",
    "offset": 100,
    "width": 236,
    "timeout": 1500,
    "volume": true,
    "brightness": true,
    "mic": true,
    "hideWhilePopupOpen": true
  },
  "notifications": {
    "_comment": "rules: [{ \"appName\": \"^Spotify$\", \"mute\": true }] - match appName/summary/body/desktopEntry (regex, case-insensitive); mute = history only, drop = discard, timeout = ms, urgency = low|normal|critical",
    "position": "top-right",
    "width": 344,
    "maxPopups": 4,
    "timeout": { "low": 4000, "normal": 6000, "critical": 0 },
    "respectAppTimeout": true,
    "dndAllowCritical": true,
    "maxHistory": 100,
    "centerMaxHeight": 560,
    "hideUnder": ["notifications", "controlCenter"],
    "rules": []
  }
}
