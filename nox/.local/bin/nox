#!/usr/bin/env bash
# nox - single entry point for the nox desktop (Hyprland Lua config + qs shell + tokens).
# Modules live in ../lib/nox/ next to the real path of this file (so a worktree's
# nox runs that worktree's modules); NOX_LIB overrides.
set -euo pipefail
LIB="${NOX_LIB:-$(cd "$(dirname "$(readlink -f "$0")")/../lib/nox" && pwd)}"
QS=(qs -c nox)
MODULES="theme shell layout shot record wallpaper dpms battery phone hypr greeter workspaces activity notes files agents voice ask shelf apps detect doctor update"

usage() {
    cat <<'EOF'
usage: nox <command> [args]
  theme  [render|check|diff|status|apply|switch <look>|revert [ts]|targets|get <path>|<look>]
  shell  start|stop|restart|status|log [-f]     (qs -c nox)
  ipc    <target> <function> [args]             (qs -c nox ipc call ...)
  toggle launcher|cc|nc|dnd|overview|session|dock|cheatsheet|clipboard|widgets|agents
  widgets [status|on|off|toggle|left|right|auto|reset]   (desktop clock column; shell.json desktopWidgets)
  layout next|prev|set <name>|get
  shot   region|screen|window|all|copy|ocr|annotate|save|pin <file>
  ask    [start|toggle|close|status|lens]       (Circle to Ask: circle anything, Claude answers; Super+Shift+A)
  shelf  [add <file|url|->...|list|open|close|toggle|remove <id>|undo|clear|status]   (drop shelf; Super+Shift+D)
  record [--fullscreen] [--sound]
  wallpaper pick|random|list [--all]|set <path>|prep <image|dir>...
            slideshow start|stop|next|prev|status|list|clear|add <path>...|remove <path>...
  dpms   on|off|toggle [monitor]
  battery [status|protect|full|toggle|limit <60-100>|reapply]   (charge limit, 80% by default)
  phone  status|send [file...]|clip|ring|commands|pair|on|off|logs|build   (KDE Connect phone link)
  hypr   status|check|on [--live]|off
  greeter sync|test|nested|install|on|off|status  (login screen on greetd)
  workspaces save [name]|restore [name]|pick|list|show [name]|rm <name>  (session: apps + window layout; alias ws)
  activity [refresh|show] [--source github|local]   (commit grid for the desktop widget)
  notes  [toggle|show|hide|new|open <file>|start|quit|qt <cmd>]   (floating markdown notepad, ~/Notes)
  files  terminal|copypath|ocr|webp|png|jpg|half|strip <file>...   (Dolphin right-click nox menu)
  agents [toggle|grid|list|usage|focus|turn|diff|send|repos|start|answer <id>|prune|hook]   (coding agents panel, Ctrl+Super+M)
  voice  [toggle|start|stop|cancel|status|tidy on|off|last|setup|server|doctor|bench]   (dictation: hold Super+Shift+Space)
  apps   [list|search <text>|updates|info|open|install|remove|update <source> <id>|upgrade|clean]   (App Manager: pacman, AUR, Flatpak, AppImage; launcher "+")
  detect [--yes|--print|--check|--get KEY]     (machine values -> git-ignored local files)
  update [--check|--no-pull|--migrate]          (git pull --ff-only, migrations, re-stow, theme apply, doctor)
  doctor [--summary]                            (check everything: packages, links, theme, extras; fix commands)
  status                                        (hypr + shell + theme + idle at a glance)
  help [command]
EOF
}

# module help: python core has argparse; bash modules carry usage in their header
module_help() {
    local f="$LIB/$1"
    if head -1 "$f" | grep -q python; then exec "$f" --help; fi
    sed -n '2,/^[^#]/{/^[^#]/d;s/^# \{0,1\}//;p}' "$f"
}

cmd="${1:-help}"
[ $# -gt 0 ] && shift
case "$cmd" in
    theme | shell | layout | shot | record | wallpaper | dpms | battery | phone | hypr | greeter | workspaces | activity | notes | files | agents | voice | ask | shelf | apps | detect | doctor | update) exec "$LIB/$cmd" "$@" ;;
    ws) exec "$LIB/workspaces" "$@" ;;
    ipc)
        [ $# -ge 2 ] || { echo "usage: nox ipc <target> <function> [args]   (targets: qs -c nox ipc show)" >&2; exit 2; }
        exec "${QS[@]}" ipc call "$@" ;;
    toggle)
        case "${1:-}" in
            launcher) exec "${QS[@]}" ipc call launcher toggle ;;
            cc) exec "${QS[@]}" ipc call controlCenter toggle ;;
            nc) exec "${QS[@]}" ipc call notifications toggle ;;
            dnd) exec "${QS[@]}" ipc call notifications toggleDnd ;;
            clipboard) exec "${QS[@]}" ipc call launcher clipboard ;;
            overview | session | dock | cheatsheet | widgets | agents) exec "${QS[@]}" ipc call "$1" toggle ;;
            *) echo "nox toggle: unknown panel '${1:-}' (launcher|cc|nc|dnd|overview|session|dock|cheatsheet|clipboard|widgets|agents)" >&2; exit 2 ;;
        esac ;;
    widgets)
        # on/off + side are runtime picks (~/.local/state/nox/widgets.json); reset = back to shell.json
        case "${1:-status}" in
            status | toggle | on | off | reset) exec "${QS[@]}" ipc call widgets "${1:-status}" ;;
            left | right | auto) "${QS[@]}" ipc call widgets side "$1" >/dev/null && exec "${QS[@]}" ipc call widgets status ;;
            *) echo "nox widgets: unknown '${1:-}' (status|on|off|toggle|left|right|auto|reset)" >&2; exit 2 ;;
        esac ;;
    status)
        rc=0
        "$LIB/hypr" status || rc=1
        "$LIB/shell" status || rc=1
        if look=$("$LIB/theme" switch 2>&1 | sed -n 's/^\* //p') && [ -n "$look" ]; then echo "theme:    look $look"; else echo "theme:    ERROR (nox theme check)"; rc=1; fi
        if pgrep -u "$UID" -x hypridle >/dev/null; then echo "hypridle: running"; else echo "hypridle: NOT running"; rc=1; fi
        exit $rc ;;
    help | -h | --help)
        if [ -n "${1:-}" ]; then
            case " $MODULES " in *" $1 "*) module_help "$1" ;; *) usage ;; esac
        else usage; fi ;;
    *) echo "nox: unknown command '$cmd' (try: nox help)" >&2; exit 2 ;;
esac
