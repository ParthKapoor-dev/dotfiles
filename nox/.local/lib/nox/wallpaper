#!/usr/bin/env bash
# nox wallpaper - choose the wallpaper for the Nox shell
# (replaces ii's wallpaper selector binds).
#
#   nox wallpaper pick [--all]     fuzzel list of every image under $NOX_WALLPAPER_DIR
#                                        (default ~/Pictures/Wallpapers/prepped, else ~/Pictures),
#                                        recursively, labelled by relative path
#   nox wallpaper random [--all]   random image from that list
#   nox wallpaper list [--all]     print the list (absolute paths)
#   nox wallpaper set <path>       (stops a running slideshow unless <path> is in it)
#   nox wallpaper slideshow start|stop|next|prev|status|list|clear|add <path>...|remove <path>...
#                                  cycle an ordered list every shell.json wallpaper.slideshowMinutes
#                                  (default 15); launcher: "%" lists it, Ctrl+Enter in "#" adds/removes
#   nox wallpaper lock [<path>|follow]
#                                  lock screen image: a fixed one, or follow the desktop (default)
#   nox wallpaper prep [--out DIR] [--force] <image|dir>...
#                                  make images into nox wallpapers (screen shape, subject on a third,
#                                  dark top strip, grain) -> ~/Pictures/Wallpapers/prepped; see wallpaper-prep
# png/jpg/jpeg/webp/avif; hidden folders are skipped, and so is Screenshots unless --all.
# The launcher has the same list with thumbnails: type "#" (provider "wallpapers").
# The shell draws it: qs -c nox ipc call wallpaper set <path>

set -uo pipefail

pics="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")"
# the processed set (nox wallpaper prep) when there is one, like the launcher's "#" list
dir="${NOX_WALLPAPER_DIR:-$pics/Wallpapers/prepped}"
[ -d "$dir" ] || dir="$pics"
dir="${dir%/}"
all=0
for a in "$@"; do [ "$a" = "--all" ] && all=1; done

list() {
    local skip=()
    [ "$all" = 1 ] || skip=(-o -name Screenshots)
    find -L "$dir" -mindepth 1 \( -name '.*' "${skip[@]}" \) -prune -o -type f \
        \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' -o -iname '*.avif' \) -print 2>/dev/null | sort
}

set_wp() {
    local p
    p=$(realpath -e -- "$1" 2>/dev/null) || { echo "nox wallpaper: no such file: $1" >&2; exit 1; }
    if ! qs -c nox ipc call wallpaper set "$p" >/dev/null 2>&1; then
        notify-send -a Wallpaper "Nox shell is not running" "Could not set $(basename "$p")" >/dev/null 2>&1
        exit 1
    fi
}

ipc() { qs -c nox ipc call wallpaper "$@" 2>/dev/null || { echo "nox wallpaper: nox shell is not running" >&2; exit 1; }; }

slideshow() {
    local cmd="${1:-status}" p
    [ $# -gt 0 ] && shift
    case "$cmd" in
        start | stop | next | prev | list | clear | status)
            ipc "slideshow${cmd^}" ;;
        add | remove)
            [ $# -gt 0 ] || { echo "usage: nox wallpaper slideshow $cmd <path>..." >&2; exit 2; }
            for a in "$@"; do
                # remove also takes paths that no longer exist
                if [ "$cmd" = add ]; then p=$(realpath -e -- "$a" 2>/dev/null) || { echo "nox wallpaper: no such file: $a" >&2; continue; }
                else p=$(realpath -m -- "$a"); fi
                ipc "slideshow${cmd^}" "$p" >/dev/null
            done ;;
        *) echo "usage: nox wallpaper slideshow start|stop|next|prev|status|list|clear|add <path>...|remove <path>..." >&2; exit 2 ;;
    esac
}

# ---- lock screen image ----
# hyprlock shows ~/.local/state/nox/lock-wallpaper (a link). `lock-link` points it at the pinned
# lock image if there is one (`nox wallpaper lock <path>`), else at the current desktop wallpaper,
# and runs from hypridle's lock_cmd right before hyprlock starts.
state="${XDG_STATE_HOME:-$HOME/.local/state}/nox"
lock_link() {
    local p
    p=$(readlink -e -- "$state/lock-wallpaper-pinned" 2>/dev/null) ||
        p=$(jq -r '.path // empty' "$state/wallpaper.json" 2>/dev/null)
    # no explicit pick: the look's own wallpaper (tokens desktop.wallpaperPath)
    [ -n "$p" ] || p=$(jq -r '.desktop.wallpaperPath // empty' "$state/tokens.json" 2>/dev/null)
    p="${p/#\~/$HOME}"
    [ -f "$p" ] || { rm -f -- "$state/lock-wallpaper"; return 0; }   # hyprlock falls back to the page colour
    ln -sfn -- "$p" "$state/lock-wallpaper"
}
lock_cmd() {
    case "${1:-}" in
        "") if [ -L "$state/lock-wallpaper-pinned" ]; then echo "pinned: $(readlink -- "$state/lock-wallpaper-pinned")"
            else echo "follows the desktop wallpaper"; fi ;;
        follow) rm -f -- "$state/lock-wallpaper-pinned"; lock_link; echo "lock screen follows the desktop wallpaper" ;;
        *) local p; p=$(realpath -e -- "$1" 2>/dev/null) || { echo "nox wallpaper: no such file: $1" >&2; exit 1; }
           ln -sfn -- "$p" "$state/lock-wallpaper-pinned"; lock_link; echo "lock screen: $p" ;;
    esac
}

case "${1:-pick}" in
    pick)
        pkill -x fuzzel && exit 0
        choice=$(list | sed "s|^$dir/||" | fuzzel --dmenu --prompt "Wallpaper  ") || exit 0
        [ -n "$choice" ] && set_wp "$dir/$choice"
        ;;
    list) list ;;
    random)
        f=$(list | shuf -n 1)
        [ -n "$f" ] || { echo "nox wallpaper: no images in $dir" >&2; exit 1; }
        set_wp "$f"
        ;;
    set) set_wp "${2:?usage: nox wallpaper set <path>}" ;;
    slideshow) shift; slideshow "$@" ;;
    lock) shift; lock_cmd "$@" ;;
    lock-link) lock_link ;;
    prep) shift; exec "$(dirname "$(realpath "$0")")/wallpaper-prep" "$@" ;;
    *) echo "usage: nox wallpaper pick|random|list [--all] | set <path> | lock [<path>|follow] | slideshow <cmd> | prep <image|dir>..." >&2; exit 2 ;;
esac
