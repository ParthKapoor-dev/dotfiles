#!/usr/bin/env bash
# nox notes - the floating markdown notepad (Ctrl+Super+S): notes-app/ (Milkdown Crepe on electron43)
# usage: nox notes [toggle|show|hide|new|open <file>|start|quit|qt <cmd>]
#   toggle     show it, or hide it when it is on screen (default)
#   show/hide  hiding parks the window on the special:notes workspace (unpinned: Hyprland won't
#              move a pinned window); showing brings it to the current desktop, pinned, focused,
#              so it keeps its place and size
#   new        show it with a new note           open <file>  show it with that note (~/Notes/*.md)
#   start      start it hidden (Hyprland exec at login), so the first show is instant
#   quit       close it (it saves first)
#   qt <cmd>   the older notepad built into the shell (qs ipc: toggle|open|hide|create)
# Notes are plain .md files in ~/Notes. Without electron43 it falls back to the shell's notepad.
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
APP="$HERE/notes-app"
CLASS="dev.nox.Notes"
ELECTRON="${NOX_ELECTRON:-electron43}"

client() {   # "address workspace-name" of the Notes window, or nothing
    hyprctl -j clients 2>/dev/null | jq -r --arg c "$CLASS" 'map(select(.class == $c)) | first | select(.) | "\(.address) \(.workspace.name)"'
}
running() { pgrep -f -- "$ELECTRON.* $APP( |\$)" >/dev/null 2>&1 || pgrep -f -- "electron.*$APP( |\$)" >/dev/null 2>&1; }
d() { hyprctl dispatch "$1" >/dev/null; }

# start (or, when it is already running, hand it the arguments)
launch() {
    if ! command -v "$ELECTRON" >/dev/null; then
        echo "nox notes: $ELECTRON missing, using the shell's notepad" >&2
        exec qs -c nox ipc call notes "${QT_CMD:-toggle}"
    fi
    setsid -f "$ELECTRON" "$APP" "$@" >/dev/null 2>&1 </dev/null
}

show() {
    local addr="$1" ws
    ws=$(hyprctl -j activeworkspace | jq -r '.id')
    d "hl.dsp.window.move({ workspace = $ws, follow = false, window = \"address:$addr\" })"
    d "hl.dsp.window.pin({ action = \"enable\", window = \"address:$addr\" })"
    d "hl.dsp.focus({ window = \"address:$addr\" })"
}
hide() {
    local addr="$1"
    d "hl.dsp.window.pin({ action = \"disable\", window = \"address:$addr\" })"
    d "hl.dsp.window.move({ workspace = \"special:notes\", follow = false, window = \"address:$addr\" })"
}

cmd="${1:-toggle}"
[ $# -gt 0 ] && shift
addr="" wsname=""
read -r addr wsname <<<"$(client || true)" || true

case "$cmd" in
    toggle)
        if [ -z "$addr" ]; then launch --show
        elif [ "$wsname" = "special:notes" ]; then show "$addr"
        else hide "$addr"; fi ;;
    show)
        if [ -z "$addr" ]; then launch --show; else show "$addr"; fi ;;
    hide)
        [ -z "$addr" ] || hide "$addr" ;;
    new)
        QT_CMD=create
        [ -z "$addr" ] || show "$addr"
        launch --new ;;
    open)
        [ $# -ge 1 ] || { echo "usage: nox notes open <file>" >&2; exit 2; }
        f="$(readlink -f -- "$1")"
        [ -z "$addr" ] || show "$addr"
        launch --open "$f" ;;
    start)
        running || launch --hidden ;;
    quit)
        [ -z "$addr" ] || d "hl.dsp.window.close({ window = \"address:$addr\" })" ;;
    qt)
        exec qs -c nox ipc call notes "${1:-toggle}" ;;
    -h | --help | help)
        sed -n '2,/^[^#]/{/^[^#]/d;s/^# \{0,1\}//;p}' "$0" ;;
    *)
        echo "nox notes: unknown command '$cmd' (toggle|show|hide|new|open <file>|start|quit|qt <cmd>)" >&2; exit 2 ;;
esac
