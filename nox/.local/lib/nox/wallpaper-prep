#!/usr/bin/env python3
"""nox wallpaper prep - make images into desktop wallpapers (nox look).

  nox wallpaper prep [--out DIR] [--force] [--jobs N] <image|dir|@listfile>...

Each image becomes <out>/<name>.jpg at exactly the size the shell draws the wallpaper (logical
screen x the rounded-up scale: 3072x1728 on a 1920x1080 panel at 1.25), so nothing is resampled
twice. Default out = ~/Pictures/Wallpapers/prepped. Originals are never touched.

  landscape (wider than 1.3:1)  cover-crop; the crop window follows the subject (edge energy) and
                                puts it on a third when there is room
  portrait / square             full height against the right edge of the screen, the rest plain
                                page colour (dark-edged art fades in on its left side, a light-edged
                                poster keeps a hard edge)
  then, for every image:        sources smaller than the screen are upscaled with Real-ESRGAN first
                                (Lanczos if it isn't installed), near-blacks pulled to the theme's
                                page colour, top strip darkened behind the bar, bright images
                                graded down, light grain on the picture (not on empty black)

Theme page colour comes from ~/.local/state/nox/tokens.json. Needs ImageMagick 7 (magick).
Upscaler: realesrgan-ncnn-vulkan (release zip from github.com/xinntao/Real-ESRGAN unpacked into
~/.local/share/nox/realesrgan, or NOX_UPSCALER=<binary>); NOX_UPSCALER_GPU picks the Vulkan
device (default 0; `-g` of the binary). NOX_WALLPAPER_SIZE=WxH overrides the size.
"""
import json, math, os, re, subprocess, sys, tempfile, threading
from concurrent.futures import ThreadPoolExecutor

EXTS = (".png", ".jpg", ".jpeg", ".webp", ".avif")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "nox")
UPSCALER = os.environ.get("NOX_UPSCALER") or os.path.expanduser("~/.local/share/nox/realesrgan/realesrgan-ncnn-vulkan")
GPU = os.environ.get("NOX_UPSCALER_GPU", "0")
gpu_lock = threading.Lock()  # one upscale at a time; the GPU is the bottleneck


def target_size():
    env = os.environ.get("NOX_WALLPAPER_SIZE", "")
    if re.fullmatch(r"\d+x\d+", env):
        return tuple(map(int, env.split("x")))
    w, h, scale = 1920, 1080, 1.0
    try:
        mons = json.loads(subprocess.run(["hyprctl", "-j", "monitors"], capture_output=True, text=True).stdout)
        m = max(mons, key=lambda m: m["width"] * m["height"])
        w, h, scale = m["width"], m["height"], m.get("scale", 1.0) or 1.0
        if m.get("transform", 0) % 2:
            w, h = h, w
    except Exception:
        pass
    # Qt draws at a whole device-pixel ratio (1.25 -> 2) and the compositor scales the buffer
    # down; matching that size means the image is decoded 1:1
    k = math.ceil(scale - 1e-6) / scale
    return round(w * k / 2) * 2, round(h * k / 2) * 2


def page_color():
    try:
        c = json.load(open(os.path.join(STATE, "tokens.json")))["color"]["page"]
        return c if re.fullmatch(r"#[0-9A-Fa-f]{6}", c) else "#000000"
    except Exception:
        return "#000000"


def magick(*args):
    r = subprocess.run(["magick", *map(str, args)], capture_output=True)
    if r.returncode:
        raise RuntimeError(r.stderr.decode(errors="replace").strip()[:300])
    return r.stdout


def size_of(src):
    w, h = magick(src + "[0]", "-format", "%w %h", "info:").split()
    return int(w), int(h)


def mean_light(src):
    return float(magick(src + "[0]", "-resize", "64x64!", "-colorspace", "gray", "-format", "%[fx:mean]", "info:"))


def subject_center(src, n=64):
    """(x, y) in 0..1: weighted center of edge energy + distance from the median tone."""
    raw = magick(src + "[0]", "-auto-orient", "-resize", f"{n}x{n}!", "-colorspace", "gray",
                 "-depth", "8", "gray:-")
    px = list(raw)
    med = sorted(px)[len(px) // 2]
    wsum = xs = ys = 0.0
    for i, v in enumerate(px):
        x, y = i % n, i // n
        right = px[i + 1] if x + 1 < n else v
        down = px[i + n] if y + 1 < n else v
        e = abs(v - right) + abs(v - down) + 0.5 * abs(v - med)
        wsum += e; xs += e * x; ys += e * y
    if wsum == 0:
        return 0.5, 0.5
    return xs / wsum / (n - 1), ys / wsum / (n - 1)


def crop_offset(slack, center, full):
    """Offset of a window inside `full` px (window = full - slack) so the subject at `center` (0..1)
    sits on the nearer third of the window, or as close as the slack allows."""
    if slack <= 0:
        return 0
    win = full - slack
    c = center * full
    third = 1 / 3 if center < 0.5 else 2 / 3
    want = c - third * win
    if abs(center - 0.5) < 0.08:  # centered subject: keep it centered
        want = c - win / 2
    return int(min(max(want, 0), slack))


def edge_is_light(src):
    """True when the image's left/right borders are light (a poster with a pale margin)."""
    v = float(magick(src + "[0]", "-auto-orient", "-colorspace", "gray", "-alpha", "off",
                     "(", "+clone", "-gravity", "west", "-crop", "4%x100%+0+0", ")",
                     "(", "-clone", "0", "-gravity", "east", "-crop", "4%x100%+0+0", ")",
                     "-delete", "0", "+append", "-format", "%[fx:mean]", "info:"))
    return v > 0.35


def upscale(src, need, tmpdir):
    """Real-ESRGAN x4 when the image has to grow by more than 5%; returns (path, factor)."""
    if need <= 1.05 or not os.access(UPSCALER, os.X_OK):
        return src, 1
    flat = os.path.join(tmpdir, "in.png")
    out = os.path.join(tmpdir, "x4.png")
    magick(src + "[0]", "-auto-orient", "-colorspace", "sRGB", "-alpha", "remove", "-alpha", "off", flat)
    models = os.path.join(os.path.dirname(UPSCALER), "models")
    with gpu_lock:
        r = subprocess.run([UPSCALER, "-i", flat, "-o", out, "-n", "realesrgan-x4plus", "-s", "4",
                            "-m", models, "-g", GPU], capture_output=True)
    if r.returncode or not os.path.exists(out):
        return src, 1
    return out, 4


def prep(src, dst, W, H, page):
    w, h = size_of(src)
    light = mean_light(src)
    cx, cy = subject_center(src)
    portrait = w / h < 1.3 and round(w * H / h) <= W * 0.9
    need = H / h if portrait else max(W / w, H / h)
    with tempfile.TemporaryDirectory(prefix="nox-wp-") as tmp:
        work, ai = upscale(src, need, tmp)
        ww, wh = w * ai, h * ai
        head = [work + "[0]", "-auto-orient", "-colorspace", "sRGB", "-alpha", "remove", "-alpha", "off"]
        grain = 0.18 + 0.22 * min(1.0, max(0.0, need - 1.0))  # attenuate: ~1.4% native, ~3% at 2x+
        soften = ai == 1 and need > 1.3  # plain Lanczos upscale: sharpen a little
        if not portrait:
            k = max(W / ww, H / wh)
            rw, rh = round(ww * k), round(wh * k)
            ox = crop_offset(rw - W, cx, rw)
            # vertical: favour keeping the bottom (the top gets the bar), but follow the subject
            oy = crop_offset(rh - H, min(cy + 0.05, 1), rh)
            body = ["-filter", "Lanczos", "-resize", f"{rw}x{rh}!", "-crop", f"{W}x{H}+{ox}+{oy}", "+repage"]
            body += ["-unsharp", "0x1+0.45+0.02"] if soften else []
            body += grain_ops(W, H, grain)
            mode = "fill"
        else:
            fw = round(ww * H / wh)
            # dark-edged art fades into the black on its left; a light-edged poster keeps a hard edge
            ramp = 1 if edge_is_light(src) else max(1, round(fw * 0.10))
            fg = ["-filter", "Lanczos", "-resize", f"{fw}x{H}!"]
            fg += ["-unsharp", "0x1+0.45+0.02"] if soften else []
            fg += grain_ops(fw, H, grain)
            body = [
                "(", "-size", f"{W}x{H}", f"xc:{page}", ")",
                "(", "-clone", "0", *fg,
                "(", "-size", f"{fw}x1", "xc:", "-fx", f"min(1,i/{ramp})", "-scale", f"{fw}x{H}!", ")",
                "-alpha", "off", "-compose", "CopyOpacity", "-composite", ")",
                "-delete", "0", "-gravity", "northeast", "-compose", "over", "-geometry", "+0+0", "-composite",
                "-gravity", "northwest",
            ]
            mode = "right"
        finish(head + body, dst, W, H, page, light)
    return mode + ("+ai" if ai > 1 else ""), w, h, need


def grain_ops(w, h, amount):
    # mono noise added around 0 (softlight brightened dark images and banded them)
    return ["(", "-size", f"{w}x{h}", "xc:gray50", "-attenuate", f"{amount:.2f}", "+noise", "Gaussian",
            "-modulate", "100,0", ")", "-compose", "Mathematics", "-define", "compose:args=0,1,1,-0.5", "-composite"]


def finish(cmd, dst, W, H, page, light):
    bar = round(H * 0.10)
    cmd += ["-level", "1.5%,100%"]  # near-blacks -> black (then page colour below)
    if light > 0.30:
        # bright image on a dark desktop: lower the midtones (gamma) more than the highlights, mute
        # colour a little, and add a soft vignette so the edges sit with the black UI
        g = max(0.5, min(0.9, 0.9 - (light - 0.30) * 1.6))
        cmd += ["-gamma", f"{g:.2f}", "-modulate", "92,85",
                "(", "-size", f"{W}x{H}", "radial-gradient:white-gray(55%)", ")",
                "-compose", "multiply", "-composite"]
    if page.lower() != "#000000":
        cmd += ["+level-colors", f"{page},white"]
    cmd += [
        # darken the strip behind the bar
        "(", "-size", f"{W}x{bar}", f"xc:{page}", "(", "-size", f"{W}x{bar}", "gradient:gray(60%)-black", ")",
        "-alpha", "off", "-compose", "CopyOpacity", "-composite", ")",
        "-gravity", "north", "-compose", "over", "-composite",
        "-strip", "-sampling-factor", "4:4:4", "-quality", "95", dst + ".part.jpg",
    ]
    magick(*cmd)
    os.replace(dst + ".part.jpg", dst)


def slug(path):
    base = os.path.splitext(os.path.basename(path))[0]
    s = re.sub(r"[^\w\-]+", "-", base).strip("-").lower()
    return s[:80] or "wallpaper"


def gather(args):
    for a in args:
        if a.startswith("@"):
            for line in open(a[1:]):
                line = line.rstrip("\n")
                if line.strip() and not line.startswith("#"):
                    yield line
        elif os.path.isdir(a):
            for root, dirs, files in os.walk(a):
                dirs[:] = sorted(d for d in dirs if not d.startswith("."))
                for f in sorted(files):
                    if f.lower().endswith(EXTS):
                        yield os.path.join(root, f)
        else:
            yield a


def main(argv):
    out = os.path.expanduser("~/Pictures/Wallpapers/prepped")
    force, jobs, items = False, 3, []
    it = iter(argv)
    for a in it:
        if a == "--out": out = os.path.expanduser(next(it))
        elif a == "--force": force = True
        elif a == "--jobs": jobs = int(next(it))
        elif a in ("-h", "--help"): print(__doc__); return 0
        else: items.append(a)
    if not items:
        print(__doc__); return 2
    W, H = target_size()
    page = page_color()
    os.makedirs(out, exist_ok=True)
    # an item may be "path<TAB>name" (from a list file) to choose the output name
    work, seen = [], set()
    for item in gather(items):
        src, _, name = item.partition("\t")
        src = os.path.expanduser(src)
        dst = os.path.join(out, (name or slug(src)) + ".jpg")
        if dst in seen:
            continue
        seen.add(dst)
        if not force and os.path.exists(dst) and os.path.getmtime(dst) >= os.path.getmtime(src):
            continue
        work.append((src, dst))
    up = "Real-ESRGAN" if os.access(UPSCALER, os.X_OK) else "Lanczos (no upscaler found)"
    print(f"{len(work)} to do -> {out} at {W}x{H}, page {page}, upscale: {up}")
    os.environ.setdefault("MAGICK_THREAD_LIMIT", "2")

    def one(job):
        src, dst = job
        try:
            mode, w, h, k = prep(src, dst, W, H, page)
            return f"ok   {mode:8} {w}x{h} x{k:.2f}  {os.path.basename(dst)}"
        except Exception as e:
            return f"FAIL {os.path.basename(src)}: {e}"

    fails = 0
    with ThreadPoolExecutor(jobs) as ex:
        for line in ex.map(one, work):
            fails += line.startswith("FAIL")
            print(line, flush=True)
    return 1 if fails else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
