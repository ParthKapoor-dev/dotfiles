# Nox terminal theme ({{ name }}, preset {{ _.preset }}) - generated by nox theme. Do not edit.
# Loaded via `config-file` at the END of ~/.config/ghostty/config, so it overrides inline colours.
background = {{ terminal.background | hex }}
foreground = {{ terminal.foreground | hex }}
cursor-color = {{ terminal.cursor | hex }}
cursor-text = {{ terminal.background | hex }}
selection-background = {{ terminal.selection | hex }}
selection-foreground = {{ terminal.foreground | hex }}
palette = 0={{ terminal.black | hex }}
palette = 1={{ terminal.red | hex }}
palette = 2={{ terminal.green | hex }}
palette = 3={{ terminal.yellow | hex }}
palette = 4={{ terminal.blue | hex }}
palette = 5={{ terminal.magenta | hex }}
palette = 6={{ terminal.cyan | hex }}
palette = 7={{ terminal.white | hex }}
palette = 8={{ terminal.brightBlack | hex }}
palette = 9={{ terminal.brightRed | hex }}
palette = 10={{ terminal.brightGreen | hex }}
palette = 11={{ terminal.brightYellow | hex }}
palette = 12={{ terminal.brightBlue | hex }}
palette = 13={{ terminal.brightMagenta | hex }}
palette = 14={{ terminal.brightCyan | hex }}
palette = 15={{ terminal.brightWhite | hex }}
split-divider-color = {{ color.label | alpha(color.sepAlpha) | over(terminal.background) | hex }}
unfocused-split-fill = {{ terminal.background | hex }}
font-family = "{{ font.mono }}"
font-size = {{ font.monoSize }}
