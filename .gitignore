# backups / editor junk
*.bak
*.bak-*
*.bak.*
*.pre-stow
*.old
*~
.#*

# generated by `theme apply` (graphite; fresh clone: run `theme apply` once)
hypr/.config/hypr/hyprlock/colors.conf
hypr/.config/hypr/hyprlock/layout.conf
fuzzel/.config/fuzzel/fuzzel_theme.ini
gtk/.config/gtk-3.0/gtk.css
gtk/.config/gtk-4.0/gtk.css
gtk/.config/gtk-3.0/bookmarks

# runtime / installer state
hypr/.config/hypr/hyprpm/
illogical-impulse/.config/illogical-impulse/installed_listfile
illogical-impulse/.config/illogical-impulse/installed_true
**/__pycache__/
*.pyc
zed/.config/zed/settings_backup.json

# crash dumps / logs (anchored: graphite has a core/ dir and core.lua)
/core
/core.[0-9]*
*.log

# tmux plugins: installed by TPM (bootstrap in tmux.conf), not committed
tmux/.config/tmux/plugins/

# graphite machine-local overrides
hypr/.config/hypr/graphite/local.lua
